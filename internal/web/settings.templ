package web

import (
	"strconv"
	"strings"
)

// Member is a Household Member as the pages show it.
type Member struct {
	ID        int64
	Name      string
	Color     string // #rrggbb
	Role      string // "admin" or "member"
	Archived  bool
	HasAvatar bool // else initials on colour
	Pet       bool // can't be an Admin or do Chores
}

// Feed is an iCal feed as Settings shows it.
type Feed struct {
	ID          int64
	Name, Color string
	LastSuccess string // when it last synced, or "never"
	Failures    int    // syncs failed in a row
	LastError   string
}

// Locks are which kinds of action need an Admin's PIN (spec §9).
type Locks struct {
	Calendar, Chores, Todos bool
}

// Google is the Google accounts section of Settings.
type Google struct {
	Configured  bool   // GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set
	RedirectURI string // to enter in the Cloud project
	Accounts    []GoogleAccount
}

type GoogleAccount struct {
	ID          int64
	Email       string
	Reconnect   bool   // Reconnect needed
	LastSuccess string // when it last synced, or "never"
	Failures    int    // syncs failed in a row
	LastError   string
	Calendars   []GoogleCalendar
}

type GoogleCalendar struct {
	ID          int64
	Name, Color string
	Enabled     bool
	ReadOnly    bool
	Members     map[int64]bool // default Members
}

// Initials are the first letters of the first two words of name.
func Initials(name string) string {
	var b strings.Builder
	for i, w := range strings.Fields(name) {
		if i == 2 {
			break
		}
		b.WriteString(strings.ToUpper(string([]rune(w)[:1])))
	}
	return b.String()
}

templ avatar(m Member) {
	if m.HasAvatar {
		<img class="avatar" src={ "/members/" + strconv.FormatInt(m.ID, 10) + "/avatar" } alt="" style="width:2.5em;height:2.5em;border-radius:50%;vertical-align:middle"/>
	} else {
		<span class="avatar" style={ "display:inline-flex;align-items:center;justify-content:center;width:2.5em;height:2.5em;border-radius:50%;color:#fff;font-weight:bold;background:" + m.Color } aria-hidden="true">{ Initials(m.Name) }</span>
	}
}

templ formError(msg string) {
	if msg != "" {
		<p role="alert">{ msg }</p>
	}
}

templ pinInput(label string) {
	<label>
		{ label }
		<input type="password" name="pin" inputmode="numeric" pattern="[0-9]{4,8}" minlength="4" maxlength="8" autocomplete="off"/>
	</label>
}

// Setup is the first-run page that creates the first Admin.
templ Setup(errMsg string) {
	@layout("Welcome to GoCasa") {
		<main>
			<h1>Welcome to GoCasa</h1>
			<p>Who looks after Settings? Add the first Admin and their PIN.</p>
			@formError(errMsg)
			<form method="post" action="/setup">
				<label>Name <input name="name" required maxlength="50"/></label>
				<label>Colour <input type="color" name="color" value="#3b82f6"/></label>
				@pinInput("PIN (4–8 digits)")
				<button>Create Admin</button>
			</form>
		</main>
	}
}

// Lock is the Admin PIN pad: pick your avatar, enter your PIN.
templ Lock(admins []Member, errMsg string) {
	@layout("Unlock Settings") {
		<main>
			<h1>Enter your PIN</h1>
			@formError(errMsg)
			<form method="post" action="/lock">
				<fieldset>
					<legend>Who are you?</legend>
					for i, m := range admins {
						<label>
							<input type="radio" name="member_id" value={ strconv.FormatInt(m.ID, 10) } required checked?={ i == 0 }/>
							@avatar(m)
							{ m.Name }
						</label>
					}
				</fieldset>
				@pinInput("PIN")
				<button>Unlock</button>
			</form>
		</main>
	}
}

func memberURL(m Member, action string) templ.SafeURL {
	return templ.SafeURL("/settings/members/" + strconv.FormatInt(m.ID, 10) + action)
}

templ memberFields(m Member) {
	<label>Name <input name="name" value={ m.Name } required maxlength="50"/></label>
	<label>Colour <input type="color" name="color" value={ m.Color }/></label>
	<label>
		Role
		<select name="role">
			<option value="member" selected?={ m.Role != "admin" }>Member</option>
			<option value="admin" selected?={ m.Role == "admin" }>Admin</option>
		</select>
	</label>
	<label><input type="checkbox" name="pet" checked?={ m.Pet }/> Pet</label>
}

// Settings is the unlocked Settings page.
templ Settings(members []Member, feeds []Feed, google Google, weather Weather, locks Locks, mealie *Mealie, errMsg string) {
	@layout("Settings") {
		<main>
			<h1>Settings</h1>
			<form method="post" action="/lock/now"><button>Lock now</button></form>
			@formError(errMsg)
			<h2>Locks</h2>
			<p>Settings always needs an Admin's PIN. A Lock makes one more kind of action need it too. Viewing and shopping lists are never locked.</p>
			<form method="post" action="/settings/locks">
				<label><input type="checkbox" name="lock_calendar" checked?={ locks.Calendar }/> Changing the calendar</label>
				<label><input type="checkbox" name="lock_chores" checked?={ locks.Chores }/> Completing chores and asking for Rewards</label>
				<label><input type="checkbox" name="lock_todos" checked?={ locks.Todos }/> Completing to-dos</label>
				<button>Save Locks</button>
			</form>
			<h2>Members</h2>
			<p>People or pets. Only Admins have a PIN, and they need one.</p>
			for _, m := range members {
				if !m.Archived {
					<section>
						<h3>
							@avatar(m)
							{ m.Name }
							if m.Role == "admin" {
								(Admin)
							}
						</h3>
						<form method="post" action={ memberURL(m, "") }>
							@memberFields(m)
							if m.Role == "admin" {
								@pinInput("New PIN (blank keeps it)")
							} else {
								@pinInput("PIN (only when making them an Admin)")
							}
							<button>Save</button>
						</form>
						<form method="post" action={ memberURL(m, "/avatar") } enctype="multipart/form-data">
							<label>Picture <input type="file" name="avatar" accept="image/jpeg,image/png,image/gif,image/webp" required/></label>
							<button>Upload</button>
						</form>
						if m.HasAvatar {
							<form method="post" action={ memberURL(m, "/avatar/delete") }>
								<button>Use initials</button>
							</form>
						}
						<form method="post" action={ memberURL(m, "/archive") }>
							<button>Archive { m.Name }</button>
						</form>
						<form method="post" action={ memberURL(m, "/delete") }>
							<button>Delete { m.Name }</button>
						</form>
					</section>
				}
			}
			<h2>Add a Member</h2>
			<form method="post" action="/settings/members">
				@memberFields(Member{Color: "#22c55e", Role: "member"})
				@pinInput("PIN (Admins only)")
				<button>Add</button>
			</form>
			<h2>Archived</h2>
			<p>Members who have left. They keep their history but are hidden everywhere else. Only a Member with no history can be deleted.</p>
			for _, m := range members {
				if m.Archived {
					<section>
						<h3>
							@avatar(m)
							{ m.Name }
						</h3>
						<form method="post" action={ memberURL(m, "/restore") }>
							<button>Restore { m.Name }</button>
						</form>
						<form method="post" action={ memberURL(m, "/delete") }>
							<button>Delete { m.Name }</button>
						</form>
					</section>
				}
			}
			<h2>Calendar feeds</h2>
			<p>Read-only iCal or webcal calendars, such as a school's or a sports team's. Their events can't be changed in GoCasa.</p>
			for _, f := range feeds {
				<section>
					<h3>
						<span aria-hidden="true" style={ "display:inline-block;width:.7em;height:.7em;border-radius:50%;background:" + f.Color }></span>
						{ f.Name }
					</h3>
					@syncStatus(f.LastSuccess, f.Failures, f.LastError)
					<form method="post" action={ templ.SafeURL("/settings/feeds/" + strconv.FormatInt(f.ID, 10) + "/delete") }>
						<button>Remove { f.Name }</button>
					</form>
				</section>
			}
			<form method="post" action="/settings/feeds">
				<label>Name <input name="name" required maxlength="50"/></label>
				<label>Address <input name="url" type="text" inputmode="url" required placeholder="webcal://…"/></label>
				<label>Colour <input type="color" name="color" value="#f59e0b"/></label>
				<button>Add feed</button>
			</form>
			@googleSection(google, members)
			@weatherSection(weather)
			@mealieSection(mealie)
		</main>
	}
}

func calendarDot(color string) string {
	return "display:inline-block;width:.7em;height:.7em;border-radius:50%;background:" + color
}

// syncStatus is an integration's last sync and, while failing, its error.
templ syncStatus(lastSuccess string, failures int, lastError string) {
	<p>Last synced: { lastSuccess }</p>
	if failures > 0 {
		<p role="alert">Sync failing ({ strconv.Itoa(failures) } in a row): { lastError }</p>
	}
}

templ googleSection(g Google, members []Member) {
	<h2>Google accounts</h2>
	if !g.Configured {
		<p>To connect Google calendars, create your own Google Cloud OAuth client and set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET (see the README). Its redirect URI is <code>{ g.RedirectURI }</code>.</p>
	} else {
		<p>Pick which calendars to show and whose events they are. Its redirect URI is <code>{ g.RedirectURI }</code>.</p>
	}
	for _, acct := range g.Accounts {
		<section>
			<h3>{ acct.Email }</h3>
			if acct.Reconnect {
				<p role="alert">Reconnect needed: Google withdrew GoCasa's access, so it has stopped syncing. Its events show as last synced.</p>
			}
			@syncStatus(acct.LastSuccess, acct.Failures, acct.LastError)
			for _, c := range acct.Calendars {
				<form method="post" action={ templ.SafeURL("/settings/google-calendars/" + strconv.FormatInt(c.ID, 10)) }>
					<fieldset>
						<legend>
							<span aria-hidden="true" style={ calendarDot(c.Color) }></span>
							{ c.Name }
							if c.ReadOnly {
								(read-only)
							}
						</legend>
						<label><input type="checkbox" name="enabled" checked?={ c.Enabled }/> Show</label>
						for _, m := range members {
							if !m.Archived {
								<label><input type="checkbox" name="member" value={ strconv.FormatInt(m.ID, 10) } checked?={ c.Members[m.ID] }/> { m.Name }</label>
							}
						}
						<button>Save { c.Name }</button>
					</fieldset>
				</form>
			}
			if g.Configured {
				<form method="post" action="/integrations/google/connect">
					<input type="hidden" name="account" value={ strconv.FormatInt(acct.ID, 10) }/>
					<button>Reconnect { acct.Email }</button>
				</form>
			}
			<form method="post" action={ templ.SafeURL("/settings/google/" + strconv.FormatInt(acct.ID, 10) + "/delete") }>
				<label>
					<input type="checkbox" name="confirm" required/>
					Disconnecting deletes its calendars and events here, with their default Members and every Member change made to its events.
				</label>
				<button>Disconnect { acct.Email }</button>
			</form>
		</section>
	}
	if g.Configured {
		<form method="post" action="/integrations/google/connect"><button>Connect a Google account</button></form>
	}
}
