package web

import (
	"strconv"
	"strings"
)

// Member is a Household Member as the pages show it.
type Member struct {
	ID        int64
	Name      string
	Color     string // #rrggbb
	Role      string // "admin" or "member"
	Archived  bool
	HasAvatar bool // else initials on colour
	Pet       bool // can't be an Admin or do Chores
}

// Feed is an iCal feed as Settings shows it.
type Feed struct {
	ID          int64
	Name, Color string
	LastSuccess string // when it last synced, or "never"
	Failures    int    // syncs failed in a row
	LastError   string
}

// Locks are which kinds of action need an Admin's PIN (spec §9).
type Locks struct {
	Calendar, Chores, Todos bool
}

// Google is the Google accounts section of Settings.
type Google struct {
	Configured  bool   // GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set
	RedirectURI string // to enter in the Cloud project
	Accounts    []GoogleAccount
}

type GoogleAccount struct {
	ID          int64
	Email       string
	Reconnect   bool   // Reconnect needed
	LastSuccess string // when it last synced, or "never"
	Failures    int    // syncs failed in a row
	LastError   string
	Calendars   []GoogleCalendar
}

type GoogleCalendar struct {
	ID          int64
	Name, Color string
	Enabled     bool
	ReadOnly    bool
	Members     map[int64]bool // default Members
}

// Initials are the first letters of the first two words of name.
func Initials(name string) string {
	var b strings.Builder
	for i, w := range strings.Fields(name) {
		if i == 2 {
			break
		}
		b.WriteString(strings.ToUpper(string([]rune(w)[:1])))
	}
	return b.String()
}

templ avatar(m Member) {
	if m.HasAvatar {
		<img class="avatar inline-block size-10 flex-none rounded-full object-cover align-middle" src={ "/members/" + strconv.FormatInt(m.ID, 10) + "/avatar" } alt=""/>
	} else {
		<span class="avatar inline-grid size-10 flex-none place-items-center rounded-full text-sm font-bold text-white" style={ "background:" + m.Color } aria-hidden="true">{ Initials(m.Name) }</span>
	}
}

templ formError(msg string) {
	if msg != "" {
		<p role="alert">{ msg }</p>
	}
}

templ pinInput(label string) {
	<label>
		{ label }
		<input type="password" name="pin" inputmode="numeric" pattern="[0-9]{4,8}" minlength="4" maxlength="8" autocomplete="off"/>
	</label>
}

// Setup is the first-run page that creates the first Admin.
templ Setup(errMsg string) {
	@layout("Welcome to GoCasa") {
		<main class="items-center">
			<form method="post" action="/setup" class="form-card max-w-md">
				<h1>Welcome to GoCasa</h1>
				<p class="text-muted">Who looks after Settings? Add the first Admin and their PIN.</p>
				@formError(errMsg)
				<label>Name <input name="name" required maxlength="50"/></label>
				<label>Colour <input type="color" name="color" value="#3b82f6" class="w-14 px-1"/></label>
				@pinInput("PIN (4–8 digits)")
				<button class="btn-primary">Create Admin</button>
			</form>
		</main>
	}
}

// PINPad is the Admin PIN pad: pick your avatar, enter your PIN.
templ PINPad(admins []Member, errMsg, next string) {
	@layout("Unlock Settings") {
		<main class="items-center">
			<form method="post" action="/lock" class="form-card max-w-md">
				<h1>Enter your PIN</h1>
				@formError(errMsg)
				if next != "" {
					<input type="hidden" name="next" value={ next }/>
				}
				<fieldset class="border-0 p-0">
					<legend>Who are you?</legend>
					for i, m := range admins {
						<label class="member-chip" style={ memberChip(m) }>
							<input type="radio" name="member_id" value={ strconv.FormatInt(m.ID, 10) } required checked?={ i == 0 } class="sr-only"/>
							@avatar(m)
							{ m.Name }
						</label>
					}
				</fieldset>
				@pinInput("PIN")
				<button class="btn-primary">Unlock</button>
			</form>
		</main>
	}
}

func memberURL(m Member, action string) templ.SafeURL {
	return templ.SafeURL("/settings/members/" + strconv.FormatInt(m.ID, 10) + action)
}

templ memberFields(m Member) {
	<label>Name <input name="name" value={ m.Name } required maxlength="50"/></label>
	<label>Colour <input type="color" name="color" value={ m.Color } class="w-14 px-1"/></label>
	<label>
		Role
		<select name="role">
			<option value="member" selected?={ m.Role != "admin" }>Member</option>
			<option value="admin" selected?={ m.Role == "admin" }>Admin</option>
		</select>
	</label>
	<label><input type="checkbox" name="pet" checked?={ m.Pet }/> Pet</label>
}

// Settings is the unlocked Settings page; sections are the Integrations' own, in order.
// The Household's own settings are on the left, the Integrations on the right; each
// Member's many forms sit in their own flyout.
templ Settings(members []Member, locks Locks, sections []templ.Component, fallback Fallback, household Household, errMsg string) {
	@page("Settings", false) {
		<main>
			@pageHead("Settings") {
				<form method="post" action="/lock/now"><button>Lock now</button></form>
			}
			@formError(errMsg)
			<div class="grid grid-cols-[minmax(0,1fr)] items-start gap-4 min-[1200px]:grid-cols-2">
				<div class="flex flex-col gap-4">
					<section class="card flex flex-col gap-3">
						<h2>Members</h2>
						<p class="text-muted">People or pets. Only Admins have a PIN, and they need one.</p>
						<ul class="flex flex-col gap-2">
							for _, m := range members {
								if !m.Archived {
									<li class="flex items-center gap-3 rounded-full p-1" style={ "background:" + pastel(m.Color) }>
										@avatar(m)
										<span class="min-w-0 flex-1 truncate font-medium">{ m.Name }</span>
										if m.Role == "admin" {
											<span class="text-sm text-muted">Admin</span>
										}
										if m.Pet {
											<span class="text-sm text-muted">Pet</span>
										}
										<button popovertarget={ "member-" + strconv.FormatInt(m.ID, 10) } class="rounded-full">Edit</button>
										<div id={ "member-" + strconv.FormatInt(m.ID, 10) } popover class="flyout">
											<h3 class="flex items-center gap-3 text-lg">
												@avatar(m)
												{ m.Name }
												if m.Role == "admin" {
													(Admin)
												}
											</h3>
											<form method="post" action={ memberURL(m, "") } class="flex flex-col items-start gap-3">
												@memberFields(m)
												if m.Role == "admin" {
													@pinInput("New PIN (blank keeps it)")
												} else {
													@pinInput("PIN (only when making them an Admin)")
												}
												<button class="btn-primary">Save</button>
											</form>
											<form method="post" action={ memberURL(m, "/avatar") } enctype="multipart/form-data">
												<label>Picture <input type="file" name="avatar" accept="image/jpeg,image/png,image/gif,image/webp" required class="max-w-full py-2"/></label>
												<button>Upload</button>
											</form>
											<div class="flex flex-wrap gap-2 border-t border-line pt-4">
												if m.HasAvatar {
													<form method="post" action={ memberURL(m, "/avatar/delete") }>
														<button>Use initials</button>
													</form>
												}
												<form method="post" action={ memberURL(m, "/archive") }>
													<button>Archive { m.Name }</button>
												</form>
												<form method="post" action={ memberURL(m, "/delete") }>
													<button class="btn-danger">Delete { m.Name }</button>
												</form>
											</div>
										</div>
									</li>
								}
							}
						</ul>
						<div class="flex flex-wrap gap-2">
							<button popovertarget="member-new" class="btn-primary">Add a Member</button>
							<button popovertarget="members-archived">Archived Members</button>
						</div>
						<div id="member-new" popover class="flyout">
							<h2>Add a Member</h2>
							<form method="post" action="/settings/members" class="flex flex-col items-start gap-3">
								@memberFields(Member{Color: "#22c55e", Role: "member"})
								@pinInput("PIN (Admins only)")
								<button class="btn-primary">Add</button>
							</form>
						</div>
						<div id="members-archived" popover class="flyout">
							<h2>Archived</h2>
							<p class="text-muted">Members who have left. They keep their history but are hidden everywhere else. Only a Member with no history can be deleted.</p>
							for _, m := range members {
								if m.Archived {
									<section class="flex flex-wrap items-center gap-2">
										<h3 class="flex flex-1 items-center gap-2">
											@avatar(m)
											{ m.Name }
										</h3>
										<form method="post" action={ memberURL(m, "/restore") }>
											<button>Restore { m.Name }</button>
										</form>
										<form method="post" action={ memberURL(m, "/delete") }>
											<button class="btn-danger">Delete { m.Name }</button>
										</form>
									</section>
								}
							}
						</div>
					</section>
					<section class="card flex flex-col gap-3">
						<h2>Locks</h2>
						<p class="text-muted">Settings always needs an Admin's PIN. A Lock makes one more kind of action need it too. Viewing and shopping lists are never locked.</p>
						<form method="post" action="/settings/locks">
							<label class="pick"><input type="checkbox" name="lock_calendar" checked?={ locks.Calendar }/> Changing the calendar</label>
							<label class="pick"><input type="checkbox" name="lock_chores" checked?={ locks.Chores }/> Completing chores</label>
							<label class="pick"><input type="checkbox" name="lock_todos" checked?={ locks.Todos }/> Completing to-dos</label>
							<button class="btn-primary">Save Locks</button>
						</form>
					</section>
					@householdSection(household)
					@thisDevice()
				</div>
				<div class="flex flex-col gap-4">
					for _, sec := range sections {
						@sec
					}
					@fallbackSection(fallback)
				</div>
			</div>
		</main>
	}
}

func calendarDot(color string) string {
	return "display:inline-block;width:.7em;height:.7em;border-radius:50%;background:" + color
}

// syncStatus is an integration's last sync and, while failing, its error.
templ syncStatus(lastSuccess string, failures int, lastError string) {
	<p class="text-sm text-muted">Last synced: { lastSuccess }</p>
	if failures > 0 {
		<p role="alert" class="break-words">Sync failing ({ strconv.Itoa(failures) } in a row): { lastError }</p>
	}
}

// integrationActions is a row of an Integration's secondary buttons (refresh, disconnect).
templ integrationActions() {
	<div class="flex flex-wrap gap-2 border-t border-line pt-3">
		{ children... }
	</div>
}

// FeedsSection is the iCal feeds' Settings section.
templ FeedsSection(feeds []Feed) {
	<section class="card flex flex-col gap-3">
		<h2>Calendar feeds</h2>
		<p class="text-muted">Read-only iCal or webcal calendars, such as a school's or a sports team's. Their events can't be changed in GoCasa.</p>
		for _, f := range feeds {
			<section class="flex flex-col gap-1 rounded-[10px] bg-soft p-3">
				<div class="flex flex-wrap items-center gap-2">
					<h3 class="flex flex-1 items-center gap-2">
						<span aria-hidden="true" style={ calendarDot(f.Color) }></span>
						{ f.Name }
					</h3>
					<form method="post" action={ templ.SafeURL("/settings/feeds/" + strconv.FormatInt(f.ID, 10) + "/delete") }>
						<button class="btn-danger">Remove { f.Name }</button>
					</form>
				</div>
				@syncStatus(f.LastSuccess, f.Failures, f.LastError)
			</section>
		}
		<form method="post" action="/settings/feeds">
			<label>Name <input name="name" required maxlength="50"/></label>
			<label>Address <input name="url" type="text" inputmode="url" required placeholder="webcal://…"/></label>
			<label>Colour <input type="color" name="color" value="#f59e0b" class="w-14 px-1"/></label>
			<button class="btn-primary">Add feed</button>
		</form>
	</section>
}

templ GoogleSection(g Google, members []Member) {
	<section class="card flex flex-col gap-3">
		<h2>Google accounts</h2>
		if !g.Configured {
			<p class="text-muted">To connect Google calendars, create your own Google Cloud OAuth client and set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET (see the README). Its redirect URI is <code class="break-all">{ g.RedirectURI }</code>.</p>
		} else {
			<p class="text-muted">Pick which calendars to show and whose events they are. Its redirect URI is <code class="break-all">{ g.RedirectURI }</code>.</p>
		}
		for _, acct := range g.Accounts {
			<section class="flex flex-col gap-3 rounded-[10px] bg-soft p-3">
				<h3 class="break-all">{ acct.Email }</h3>
				if acct.Reconnect {
					<p role="alert">Reconnect needed: Google withdrew GoCasa's access, so it has stopped syncing. Its events show as last synced.</p>
				}
				@syncStatus(acct.LastSuccess, acct.Failures, acct.LastError)
				for _, c := range acct.Calendars {
					<form method="post" action={ templ.SafeURL("/settings/google-calendars/" + strconv.FormatInt(c.ID, 10)) } class="flex">
						<fieldset class="flex-1 bg-card">
							<legend class="flex items-center gap-2">
								<span aria-hidden="true" style={ calendarDot(c.Color) }></span>
								{ c.Name }
								if c.ReadOnly {
									(read-only)
								}
							</legend>
							<label class="pick"><input type="checkbox" name="enabled" checked?={ c.Enabled }/> Show</label>
							for _, m := range members {
								if !m.Archived {
									<label class="member-chip" style={ memberChip(m) }>
										<input type="checkbox" name="member" value={ strconv.FormatInt(m.ID, 10) } checked?={ c.Members[m.ID] } class="sr-only"/>
										@avatar(m)
										{ m.Name }
									</label>
								}
							}
							<button class="ml-auto">Save { c.Name }</button>
						</fieldset>
					</form>
				}
				@integrationActions() {
					if g.Configured {
						<form method="post" action="/integrations/google/connect">
							<input type="hidden" name="account" value={ strconv.FormatInt(acct.ID, 10) }/>
							<button>Reconnect { acct.Email }</button>
						</form>
					}
					<details class="min-w-0 flex-1">
						<summary class="flex min-h-11 cursor-pointer items-center text-now">Disconnect…</summary>
						<form method="post" action={ templ.SafeURL("/settings/google/" + strconv.FormatInt(acct.ID, 10) + "/delete") }>
							<label>
								<input type="checkbox" name="confirm" required/>
								Disconnecting deletes its calendars and events here, with their default Members and every Member change made to its events.
							</label>
							<button class="btn-danger">Disconnect { acct.Email }</button>
						</form>
					</details>
				}
			</section>
		}
		if g.Configured {
			<form method="post" action="/integrations/google/connect"><button class="btn-primary">Connect a Google account</button></form>
		}
	</section>
}
