package web

import (
	"slices"
	"strconv"
)

// MemberPage is one Member's today at a glance, in Standard style.
type MemberPage struct {
	Member    Member
	Day       TodayPage    // the clock and weather; Days[0] is today's events, Days[1] tomorrow's
	Groups    []ChoreGroup // Morning, Afternoon, Evening and Other chores, in that order
	RoutineIn int          // seconds until the next Routine starts (Morning at midnight), when the page refetches
	Todos     []Todo       // their columns' open to-dos due by today or undated, capped
	MoreTodos int          // how many more the cap leaves for the To-dos page
	Balance   int          // this Member's points
	Rewards   []Reward     // not archived, cheapest first
	Waiting   []Redemption // this Member's pending Redemptions, oldest first
}

// ChoreGroup is one Routine's share of a Member's Chores today, in the
// Routine's order, or under "other" the rest of their Chores. Each Chore has
// its claimable Rounds with only this Member's taps (and an Anyone chore's
// completer).
type ChoreGroup struct {
	Routine string // morning, afternoon, evening or other
	Current bool   // the slot times put now in this Routine
	Chores  []Chore
}

// Progress is how many of the group's Rounds are done, of all of them.
func (g ChoreGroup) Progress() (done, total int) {
	for _, c := range g.Chores {
		for _, rd := range c.Rounds {
			total++
			if slices.ContainsFunc(rd.Taps, func(t ChoreTap) bool { return t.Ticked() }) {
				done++
			}
		}
	}
	return done, total
}

// Pending reports whether any claimable Round still needs confirmation.
func (g ChoreGroup) Pending() bool {
	for _, c := range g.Chores {
		for _, rd := range c.Rounds {
			if slices.ContainsFunc(rd.Taps, func(t ChoreTap) bool { return t.Provisional }) {
				return true
			}
		}
	}
	return false
}

// progressText is a group's progress as people read it, "2 of 4".
func progressText(g ChoreGroup) string {
	done, total := g.Progress()
	return strconv.Itoa(done) + " of " + strconv.Itoa(total)
}

// groupStyle tints the current Routine's group in the Member's colour.
func groupStyle(g ChoreGroup, color string) string {
	if g.Current {
		return "background:" + pastel(color)
	}
	return ""
}

// path is the Member page's own URL, where its actions return.
func (p MemberPage) path() string { return "/members/" + id(p.Member.ID) }

// MemberPageView is the Member page in Standard style: denser like Today, with
// a one-line peek at tomorrow's first event. Nothing in GoCasa links to it.
templ MemberPageView(p MemberPage) {
	@page(p.Member.Name+" · Member page", false) {
		<div id="live" data-member-page={ id(p.Member.ID) } { live(KindEvent, KindChore, KindTodo, KindPoints, KindMember, KindHousehold, KindIntegration)... } class="grid grid-cols-[minmax(0,1fr)] gap-4 p-5 min-[760px]:min-h-[calc(100vh-4rem)] min-[760px]:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] min-[760px]:grid-rows-[auto_1fr]">
			<header class="flex flex-wrap items-center gap-x-7 gap-y-4 min-[760px]:col-span-full">
				<div class="flex items-center gap-3">
					@avatar(p.Member)
					<div>
						<h1 class="text-3xl">{ p.Member.Name }</h1>
						<p class="text-xl text-muted">
							<span class="tabular-nums">@clock(p.Day)</span> · { p.Day.Now.Format("Monday 2 January") }
						</p>
					</div>
				</div>
				@weatherSummary(p.Day.Weather)
				<button id="member-bedtime" type="button" hidden hx-preserve="true" class="ml-auto">Bedtime</button>
			</header>
			<main class="card gap-5">
				@calendarDay(p.Day.Days[0], "Today")
				<section id="member-tomorrow" class="flex flex-wrap gap-x-2.5 text-muted">
					<strong>Tomorrow</strong>
					if evs := p.Day.Days[1].Events; len(evs) > 0 {
						<span class="tabular-nums">{ evs[0].Time }</span> <span class="text-ink">{ evs[0].Title }</span>
					} else {
						<span>Nothing tomorrow.</span>
					}
				</section>
			</main>
			<div class="flex flex-col content-start gap-4">
				<section id="member-chores" data-routine-in={ strconv.Itoa(p.RoutineIn) } class="card flex flex-col gap-3">
					<h2 class="text-muted">Chores today</h2>
					for _, g := range p.Groups {
						@choreGroup(g, p)
					}
				</section>
				@memberTodos(p)
				<section id="member-points" class="card flex flex-col gap-3">
					<h2 class="flex items-baseline justify-between gap-2">
						<span class="text-muted">Points</span>
						<span><b class="text-lg tabular-nums" data-balance={ id(p.Member.ID) }>{ strconv.Itoa(p.Balance) }</b> points</span>
					</h2>
					for _, rd := range p.Waiting {
						<p class="flex flex-wrap items-center gap-2 rounded-[10px] bg-soft px-2.5 py-2">
							<span class="flex-1">{ rd.Reward.Name } ({ strconv.Itoa(rd.Reward.Cost) } points)</span>
							<strong class="text-late">waiting</strong>
						</p>
					}
					if len(p.Rewards) == 0 {
						<p class="text-muted">No Rewards yet.</p>
					}
					for _, rw := range p.Rewards {
						if p.Balance >= rw.Cost {
							<form method="post" action={ templ.SafeURL("/rewards/" + id(rw.ID) + "/redeem") } class="contents">
								<input type="hidden" name="member_id" value={ id(p.Member.ID) }/>
								<input type="hidden" name="next" value={ p.path() }/>
								<button aria-label={ "Ask for " + rw.Name } class="flex items-center justify-between gap-2 rounded-[10px] border-transparent px-2.5 py-2 text-left" style={ "background:" + pastel(p.Member.Color) }>
									<b>{ rw.Name }</b>
									<span class="tabular-nums">{ strconv.Itoa(rw.Cost) } points</span>
								</button>
							</form>
						} else {
							<div data-reward={ id(rw.ID) } class="flex items-center justify-between gap-2 rounded-[10px] bg-soft px-2.5 py-2 text-muted">
								<span>{ rw.Name }</span>
								<span class="text-sm tabular-nums">{ strconv.Itoa(rw.Cost - p.Balance) } more</span>
							</div>
						}
					}
				</section>
			</div>
		</div>
		@liveDrafts()
		@ticker()
	}
}

// choreGroup is one Routine's Chores, or Other chores, with its progress; the
// current Routine is tinted in the Member's colour.
templ choreGroup(g ChoreGroup, p MemberPage) {
	<div data-group={ g.Routine } data-current?={ g.Current } class="flex flex-col gap-3 rounded-[10px] border border-line p-2.5" style={ groupStyle(g, p.Member.Color) }>
		<h3 class="flex items-baseline justify-between gap-2">
			<span class="flex items-baseline gap-2">
				<b>{ routineName(g.Routine) }</b>
				if g.Current {
					<span class="text-sm text-muted">now</span>
				}
			</span>
			if len(g.Chores) > 0 {
				<span class="text-sm tabular-nums text-muted">{ progressText(g) }</span>
			}
		</h3>
		if g.Pending() {
			<a href={ templ.SafeURL(p.path() + "/routines/" + g.Routine + "/confirm") }>Confirm</a>
		}
		if len(g.Chores) == 0 {
			<p class="text-muted">No chores.</p>
		}
		for _, c := range g.Chores {
			@choreRow(c, p.path())
		}
	</div>
}

// memberTodos is the Member's columns' to-dos for today; ticking one comes back here.
templ memberTodos(p MemberPage) {
	<section id="member-todos" class="card flex flex-col gap-3">
		<h2 class="text-muted">To-dos</h2>
		if len(p.Todos) == 0 {
			<p class="text-muted">No to-dos today.</p>
		} else {
			<ul class="flex flex-col gap-1.5">
				for _, t := range p.Todos {
					<li data-todo={ id(t.ID) } class="flex flex-wrap items-center gap-x-2 rounded-lg bg-soft py-1 pr-1 pl-3">
						<span class="min-w-0 flex-1 py-2">{ t.Title }</span>
						if t.Overdue {
							<span class="text-sm text-late">overdue</span>
						}
						<form method="post" action={ templ.SafeURL("/todos/" + id(t.ID) + "/complete") }>
							<input type="hidden" name="next" value={ p.path() }/>
							<button aria-label={ "Done: " + t.Title } class="rounded-full">Done</button>
						</form>
					</li>
				}
			</ul>
		}
		if p.MoreTodos > 0 {
			<a href="/todos" class="text-muted">{ strconv.Itoa(p.MoreTodos) } more on To-dos</a>
		}
	</section>
}

// MemberUnavailable is the plain page for a Member with no Member page:
// archived, deleted, unknown or a pet.
templ MemberUnavailable() {
	<!DOCTYPE html>
	<html lang="en" data-theme={ device(ctx).Theme }>
		<head>
			@head("Member page")
		</head>
		<body>
			<main class="grid min-h-dvh place-items-center p-5">
				<p class="text-xl">This Member page isn't available. Ask an Admin to choose another Member.</p>
			</main>
		</body>
	</html>
}
