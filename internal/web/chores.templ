package web

import (
	"strconv"
	"strings"
)

// Weekdays are the chosen-weekday codes in the order the form shows them.
var Weekdays = []string{"MO", "TU", "WE", "TH", "FR", "SA", "SU"}

// Chore is a Chore with the Rounds that can still be claimed.
type Chore struct {
	ID        int64
	Name      string
	Schedule  string // daily, weekdays, weekly or monthly
	Days      string // chosen weekdays, e.g. "MO,WE"
	Anyone    bool   // else an Each chore
	Points    int
	Archived  bool
	Assignees map[int64]bool // on the edit page
	Rounds    []ChoreRound   // oldest first
}

// ChoreRound is one claimable Round and who can tap it or has done it.
type ChoreRound struct {
	Start string // YYYY-MM-DD
	Late  bool
	Taps  []ChoreTap
}

// ChoreTap is a Member's avatar on a Round: done when CompletionID is set.
type ChoreTap struct {
	Member       Member
	CompletionID int64
}

func schedule(c Chore) string {
	switch c.Schedule {
	case "weekdays":
		return strings.ReplaceAll(c.Days, ",", ", ")
	case "":
		return ""
	}
	return strings.ToUpper(c.Schedule[:1]) + c.Schedule[1:]
}

// choreRounds is a Chore's claimable Rounds as avatar taps; next is the page to return to.
templ choreRounds(c Chore, next string) {
	for _, rd := range c.Rounds {
		<div class="round" data-round={ rd.Start }>
			if rd.Late {
				<strong>Late</strong> ({ rd.Start })
			}
			for _, t := range rd.Taps {
				if t.CompletionID == 0 {
					<form method="post" action={ templ.SafeURL("/chores/" + id(c.ID) + "/complete") } style="display:inline">
						<input type="hidden" name="member_id" value={ id(t.Member.ID) }/>
						<input type="hidden" name="round" value={ rd.Start }/>
						<input type="hidden" name="next" value={ next }/>
						<button aria-label={ t.Member.Name + " did " + c.Name }>
							@avatar(t.Member)
							{ t.Member.Name }
						</button>
					</form>
				} else {
					<span class="done">
						@avatar(t.Member)
						{ t.Member.Name } done
					</span>
					<form method="post" action={ templ.SafeURL("/chores/completions/" + id(t.CompletionID) + "/delete") } style="display:inline">
						<input type="hidden" name="next" value={ next }/>
						<button>Undo</button>
					</form>
				}
			}
		</div>
	}
}

templ choreFields(c Chore, people []Member) {
	<label>Name <input name="name" required maxlength="100" value={ c.Name }/></label>
	<label>
		Comes back
		<select name="schedule">
			@option("daily", "Daily", c.Schedule)
			@option("weekdays", "On chosen weekdays", c.Schedule)
			@option("weekly", "Weekly", c.Schedule)
			@option("monthly", "Monthly", c.Schedule)
		</select>
	</label>
	for _, d := range Weekdays {
		<label><input type="checkbox" name="days" value={ d } checked?={ strings.Contains(c.Days, d) }/> { d }</label>
	}
	<label>
		Who
		<select name="kind">
			<option value="each" selected?={ !c.Anyone }>Each assignee does their own</option>
			<option value="anyone" selected?={ c.Anyone }>Anyone assigned, once per Round</option>
		</select>
	</label>
	<label>Points <input type="number" name="points" min="0" max="10000" required value={ strconv.Itoa(c.Points) }/></label>
	<fieldset>
		<legend>Assigned to</legend>
		for _, m := range people {
			<label><input type="checkbox" name="assignees" value={ id(m.ID) } checked?={ c.Assignees[m.ID] }/> { m.Name }</label>
		}
	</fieldset>
}

// ChoresBoard is the chore board: tap your avatar to complete a Round.
templ ChoresBoard(chores []Chore, people []Member) {
	@layout("Chores") {
		<main>
			<h1>Chores</h1>
			<p><a href="/">Home</a></p>
			@defaultViewButton("/chores")
			<div id="live">
				for _, c := range chores {
					if !c.Archived {
						<section data-chore={ id(c.ID) }>
							<h2><a href={ templ.SafeURL("/chores/" + id(c.ID)) }>{ c.Name }</a></h2>
							<p>
								{ schedule(c) } · { strconv.Itoa(c.Points) } points
								if c.Anyone {
									· anyone
								}
							</p>
							if len(c.Rounds) == 0 {
								<p>Not today.</p>
							}
							@choreRounds(c, "/chores")
						</section>
					}
				}
			</div>
			<details>
				<summary>Set up a Chore (Admin)</summary>
				<form method="post" action="/chores">
					@choreFields(Chore{Schedule: "daily", Assignees: map[int64]bool{}}, people)
					<button>Add Chore</button>
				</form>
			</details>
			<h2>Archived</h2>
			for _, c := range chores {
				if c.Archived {
					<form method="post" action={ templ.SafeURL("/chores/" + id(c.ID) + "/restore") }>
						{ c.Name } <button>Restore { c.Name }</button>
					</form>
				}
			}
		</main>
		@liveUpdates()
	}
}

// ChorePage edits a Chore; changes only affect future Rounds.
templ ChorePage(c Chore, people []Member) {
	@layout("Chore") {
		<main>
			<h1>{ c.Name }</h1>
			<form method="post" action={ templ.SafeURL("/chores/" + id(c.ID)) }>
				@choreFields(c, people)
				<button>Save</button>
			</form>
			if !c.Archived {
				<form method="post" action={ templ.SafeURL("/chores/" + id(c.ID) + "/archive") }>
					<button>Archive { c.Name }</button>
				</form>
			}
			<p><a href="/chores">Back</a></p>
		</main>
	}
}
