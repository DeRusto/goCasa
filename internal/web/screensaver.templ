package web

import "strconv"

// Photo is one photo of a screensaver step: its proxied address and caption ("" for none).
type Photo struct {
	Src     string `json:"src"`
	Caption string `json:"caption"`
}

// Slides is what the screensaver's photos show: the step showing now (no
// photos for plain dark) and the seconds it still shows, under the
// Household's fit ("fill" crops to the screen, "blur" fits the photo over a
// blurred copy) and slow zoom.
type Slides struct {
	Photos  []Photo
	Seconds int
	Fit     string
	Zoom    bool
}

// frosted is a screensaver panel: dark glass that blurs the photo behind it.
const frosted templ.SafeCSS = "background:rgba(20,20,20,.35);-webkit-backdrop-filter:blur(18px) saturate(1.3);backdrop-filter:blur(18px) saturate(1.3);border:1px solid rgba(255,255,255,.18);border-radius:28px;padding:1.5rem 2rem;box-shadow:0 8px 32px rgba(0,0,0,.25);"

// slideCSS lays out #slides: each step is a .slide of one or two .frames
// (a Photo pair) side by side, the newest on top fading in over the last.
// The slow zoom animates only transform, so the clock above doesn't stutter.
const slideCSS = `
#slides .slide{position:fixed;inset:0;display:flex;gap:6px;background:#000;animation:fade 1s}
#slides .frame{position:relative;flex:1;overflow:hidden}
#slides img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#slides[data-fit=blur] .photo{object-fit:contain}
#slides .bg{filter:blur(40px) brightness(.75);transform:scale(1.2)}
#slides[data-zoom] .photo{animation:drift var(--s,30s) linear both}
#slides .caption{position:absolute;left:1rem;bottom:1rem;font-size:1.25rem;padding:.5rem 1rem;border-radius:16px;background:rgba(20,20,20,.45);border:1px solid rgba(255,255,255,.18)}
@keyframes fade{from{opacity:0}}
@keyframes drift{to{transform:scale(1.1) translate(var(--x,0),var(--y,0))}}
@media (prefers-reduced-motion:reduce){#slides .slide,#slides[data-zoom] .photo{animation:none}}
`

// Screensaver is what an idle Wall display shows: the clock and today's
// agenda over the current step's photos, which change in place, so the page
// and its camera stay up. The whole screen is one link to "/", so the first
// touch only wakes it, back to the Default view at today.
templ Screensaver(p TodayPage, s Slides, nightSeconds int) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<title>Screensaver</title>
			@htmx()
			@templ.Raw("<style>" + slideCSS + "</style>")
		</head>
		<body style="margin:0;background:#000;color:#ddd;font-family:system-ui,sans-serif">
			<div id="slides" data-fit={ s.Fit } data-zoom?={ s.Zoom }>
				<div class="slide" style="animation:none">
					for _, ph := range s.Photos {
						<div class="frame">
							if s.Fit == "blur" {
								<img class="bg" src={ ph.Src } alt=""/>
							}
							<img class="photo" src={ ph.Src } alt="" onerror="this.parentNode.hidden=true"/>
							if ph.Caption != "" {
								<span class="caption">{ ph.Caption }</span>
							}
						</div>
					}
				</div>
			</div>
			<a id="wake" href="/" aria-label="Wake" style="position:fixed;inset:0;display:block;padding:2rem;color:inherit;text-decoration:none;cursor:none;text-shadow:0 0 .3em #000">
				<div id="live" { live(KindEvent, KindHousehold, KindIntegration)... } style="display:flex;justify-content:space-between;align-items:flex-start;gap:2rem">
					<div style={ frosted + "max-width:min(40rem,60vw)" }>
						<p style="font-size:6rem;margin:0;line-height:1.1;font-weight:300">@clock(p)</p>
						<p style="font-size:2rem;margin:0">{ p.Now.Format("Monday 2 January") }</p>
						<ul style="font-size:1.5rem;list-style:none;padding:0;margin:1rem 0 0;display:flex;flex-direction:column;gap:.25rem">
							for _, e := range p.Days[0].Events {
								<li
									style={ templ.KV("opacity:.5", e.Past) }
									if e.End != 0 {
										data-end={ strconv.FormatInt(e.End, 10) }
									}
								>{ e.Time } { e.Title }</li>
							}
						</ul>
					</div>
					if w := p.Weather; w != nil {
						<div style={ frosted + "display:flex;align-items:center;gap:1.5rem" } role="img" aria-label={ w.Conditions + ", " + deg(w.Current) + w.Unit }>
							<span style="display:block;width:7rem;flex:none">
								@wxIcon(w.Conditions, w.Day, "")
							</span>
							<span style="font-size:6rem;line-height:1;font-weight:300">{ deg(w.Current) }</span>
						</div>
					}
				</div>
			</a>
			@liveDrafts()
			@ticker()
			@nightWatch(nightSeconds)
			if device(ctx).WallDisplay {
				@wallDisplay(0)
			}
			if device(ctx).MotionWake {
				@motionWake()
			}
			<script data-photo-seconds={ strconv.Itoa(s.Seconds) }>
			(() => {
				const box = document.getElementById("slides"), blur = box.dataset.fit === "blur";
				const portrait = matchMedia("(orientation: portrait)");
				const drift = (f, seconds) => { // a random direction per photo
					f.style.setProperty("--s", seconds + "s");
					f.style.setProperty("--x", (Math.random() * 8 - 4).toFixed(1) + "%");
					f.style.setProperty("--y", (Math.random() * 8 - 4).toFixed(1) + "%");
				};
				const srcs = el => [...el.querySelectorAll(".photo")].map(i => i.getAttribute("src")).join(" ");
				// show fades in step's photos over the current ones once they have
				// loaded, so no partly drawn photo shows; a broken one is left out.
				const show = async (photos, seconds) => {
					const cur = box.lastElementChild;
					if (srcs(cur) === photos.map(p => p.src).join(" ")) return;
					const slide = document.createElement("div");
					slide.className = "slide";
					const frames = photos.map(p => {
						const f = document.createElement("div");
						f.className = "frame";
						drift(f, seconds);
						if (blur) {
							const bg = new Image();
							bg.className = "bg";
							bg.alt = "";
							bg.src = p.src;
							f.append(bg);
						}
						const img = new Image();
						img.className = "photo";
						img.alt = "";
						img.src = p.src;
						f.append(img);
						if (p.caption) {
							const c = document.createElement("span");
							c.className = "caption";
							c.textContent = p.caption;
							f.append(c);
						}
						return f;
					});
					const ok = await Promise.all(frames.map(f => f.querySelector(".photo").decode().then(() => true, () => false)));
					slide.append(...frames.filter((_, i) => ok[i]));
					box.append(slide);
					setTimeout(() => { while (box.firstElementChild !== slide) box.firstElementChild.remove(); }, 1100); // after the fade
				};
				for (const f of box.querySelectorAll(".frame")) drift(f, Number(document.currentScript.dataset.photoSeconds) || 30);
				let timer;
				const next = async () => {
					clearTimeout(timer);
					let due = Date.now() + 60 * 1000;
					try {
						const p = await (await fetch("/screensaver/photo" + (portrait.matches ? "?portrait=1" : ""), { headers: { "X-Background": "1" } })).json();
						due = Date.now() + (p.seconds || 60) * 1000; // the step's end, however long its photos take to load
						await show(p.photos || [], p.seconds);
					} catch {}
					timer = setTimeout(next, Math.max(0, due - Date.now()));
				};
				// The page renders for a landscape screen; a portrait one asks for its own step now, and so does a screen turned either way.
				timer = setTimeout(next, portrait.matches ? 0 : (Number(document.currentScript.dataset.photoSeconds) || 60) * 1000);
				portrait.addEventListener("change", next);
			})();
			</script>
		</body>
	</html>
}

// Night is what a Wall display shows in Night mode's hours instead of the
// screensaver: mode "black" is a black screen without the wake lock, so the
// device's own power settings may turn the display off; "dim_clock" keeps the
// wake lock and shows a dimmed time and date. As on the screensaver, a touch
// goes to "/" (idle then comes back here), and data-night tells a wake script
// which mode it is in.
templ Night(mode string, p TodayPage, reloadSeconds int) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<title>Night</title>
			@htmx()
		</head>
		<body style="margin:0;background:#000;color:#333;font-family:system-ui,sans-serif">
			<a id="wake" href="/" aria-label="Wake" data-night={ mode } style="position:fixed;inset:0;display:block;padding:2rem;color:inherit;text-decoration:none;cursor:none">
				if mode == "dim_clock" {
					<p style="font-size:6rem;margin:0;font-weight:300">@clock(p)</p>
					<p style="font-size:2rem;margin:0">{ p.Now.Format("Monday 2 January") }</p>
				}
			</a>
			if mode == "dim_clock" && device(ctx).WallDisplay {
				@wallDisplay(0)
			}
			if mode == "dim_clock" && device(ctx).MotionWake {
				@motionWake()
			}
			@ticker()
			<div hidden hx-ext="sse" sse-connect="/events/stream" hx-trigger={ "sse:" + string(KindHousehold) }></div>
			@nightWatch(reloadSeconds)
		</body>
	</html>
}

// nightWatch reloads the screensaver or Night page after seconds (0: never),
// when Night mode starts or ends, which swaps one page for the other, and on
// any change to the household's settings, which may move those hours. It rides
// the page's one htmx SSE connection (the screensaver's #live, or Night's
// hidden one), which must trigger on sse:household; the extension reconnects
// a dropped stream.
templ nightWatch(seconds int) {
	<script data-reload-seconds={ strconv.Itoa(seconds) }>
	(() => {
		const s = Number(document.currentScript.dataset.reloadSeconds);
		if (s > 0) setTimeout(() => location.reload(), s * 1000);
		document.addEventListener("sse:household", () => location.reload());
		let opened;
		document.addEventListener("htmx:sseOpen", () => { if (opened) location.reload(); opened = true; }); // a change may have been missed while away
	})();
	</script>
}

// motionWake watches the camera on the screensaver and Dim clock: it compares
// each frame, downscaled to 64×48, with the one before, and when enough
// pixels change it wakes the page like a touch on #wake. Frames stay in this
// page; #camera shows while it runs.
templ motionWake() {
	<span id="camera" hidden role="img" aria-label="Camera motion-wake on" style="position:fixed;right:1rem;bottom:1rem;color:#555;font-size:1.25rem;pointer-events:none">&#x1F4F7;&#xFE0E;</span>
	<script>
	(async () => {
		if (!window.isSecureContext || !navigator.mediaDevices) return; // Settings shows why
		let stream;
		try {
			stream = await navigator.mediaDevices.getUserMedia({ video: { width: 320, height: 240 } });
		} catch {
			return;
		}
		const video = document.createElement("video");
		video.muted = true;
		video.playsInline = true;
		video.srcObject = stream;
		try {
			await video.play();
		} catch { // playback blocked: stop the camera rather than run it with no icon
			stream.getTracks().forEach(t => t.stop());
			return;
		}
		const w = 64, h = 48, canvas = document.createElement("canvas");
		canvas.width = w;
		canvas.height = h;
		const g = canvas.getContext("2d", { willReadFrequently: true });
		document.getElementById("camera").hidden = false;
		// Fixed sensitivity: a pixel changed when its R+G+B moves by over 96; motion is over 5% of pixels changed.
		const pixelDelta = 96, motionShare = 0.05;
		let prev;
		const tick = () => {
			g.drawImage(video, 0, 0, w, h);
			const d = g.getImageData(0, 0, w, h).data;
			if (prev) {
				let changed = 0;
				for (let i = 0; i < d.length; i += 4) {
					if (Math.abs(d[i] + d[i + 1] + d[i + 2] - prev[i] - prev[i + 1] - prev[i + 2]) > pixelDelta) changed++;
				}
				if (changed > w * h * motionShare) {
					stream.getTracks().forEach(t => t.stop());
					return document.getElementById("wake").click();
				}
			}
			prev = d;
			setTimeout(tick, 250); // 4 fps: enough to see someone walk up, and well under a video-activity rate
		};
		setTimeout(tick, 2000); // let the camera's exposure settle first, or its first frames read as motion
	})();
	</script>
}

// wallDisplay holds a Screen Wake Lock where the browser allows it, showing
// its status in This device's #wake-lock, and, with idleSeconds > 0, opens the
// screensaver after that long with no touch, pointer or key input.
templ wallDisplay(idleSeconds int) {
	<script data-idle-seconds={ strconv.Itoa(idleSeconds) }>
	(() => {
		const idle = Number(document.currentScript.dataset.idleSeconds);
		const status = s => { const el = document.getElementById("wake-lock"); if (el) el.textContent = s; };
		let lock;
		const hold = async () => {
			if (!window.isSecureContext) return status("needs HTTPS");
			if (!("wakeLock" in navigator)) return status("not supported by this browser");
			if (document.visibilityState !== "visible" || (lock && !lock.released)) return;
			try {
				lock = await navigator.wakeLock.request("screen");
				status("held");
				lock.addEventListener("release", () => status("released"));
			} catch (e) {
				status("not allowed: " + e.message);
			}
		};
		document.addEventListener("visibilitychange", hold); // the browser drops the lock when the page hides
		hold();
		if (idle > 0) {
			let timer;
			const reset = () => { clearTimeout(timer); timer = setTimeout(() => location.assign("/screensaver"), idle * 1000); };
			for (const e of ["pointerdown", "pointermove", "touchstart", "keydown", "wheel"]) addEventListener(e, reset, { capture: true, passive: true });
			reset();
		}
	})();
	</script>
}
