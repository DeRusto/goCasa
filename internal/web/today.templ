package web

import (
	"strconv"
	"time"
)

// TodayPage is the Today page: always the whole Household, no Member filter.
type TodayPage struct {
	Now        time.Time // in the household's timezone
	Clock      string    // Now's time, 12- or 24-hour as the Household has it
	Clock24    bool
	MidnightIn int            // seconds to the household's next midnight, when the day turns
	Weather    *WeatherHeader // nil: no cached weather
	Days       [2]CalendarDay // today and tomorrow
	Chores     []Chore        // with a Round that can be claimed today
	Todos      []Todo         // open, due today or overdue, oldest due first
}

// Today is the at-a-glance page of the day (spec §8).
templ Today(p TodayPage) {
	@page("Today", false) {
		<div id="live" { live(KindEvent, KindTodo, KindChore, KindMember, KindHousehold, KindIntegration)... }>
			<header>
				<p style="font-size:4rem;margin:0">@clock(p)</p>
				<h1>{ p.Now.Format("Monday 2 January") }</h1>
				if w := p.Weather; w != nil {
					<p style="font-size:2rem;margin:0">
						{ deg(w.Current) + w.Unit } { w.Conditions }
						if w.HasToday {
							· H { deg(w.High) } L { deg(w.Low) }
						}
					</p>
					<ol style="display:flex;gap:1.5em;list-style:none;padding:0">
						for _, d := range w.Ahead {
							<li>{ d.Day } { d.Conditions } { deg(d.High) } / { deg(d.Low) }</li>
						}
					</ol>
				}
			</header>
			<main>
				@defaultViewButton("/today")
				@calendarDay(p.Days[0], "Today")
				@calendarDay(p.Days[1], "Tomorrow")
				<section id="today-chores">
					<h2><a href="/chores">Chores</a></h2>
					if len(p.Chores) == 0 {
						<p>No chores today.</p>
					}
					for _, c := range p.Chores {
						<h3>{ c.Name }</h3>
						@choreRounds(c, "/today")
					}
				</section>
				<section id="today-todos">
					<h2><a href="/todos">To-dos</a></h2>
					if len(p.Todos) == 0 {
						<p>Nothing due.</p>
					}
					<ul>
						for _, t := range p.Todos {
							<li>
								<a href={ templ.SafeURL("/todos/" + id(t.ID)) }>{ t.Title }</a>
								if t.Overdue {
									<strong>Overdue</strong> (due { t.Due })
								}
							</li>
						}
					</ul>
				</section>
			</main>
		</div>
		@liveDrafts()
		@ticker()
	}
}

// clock is the household's time, ticked by ticker in the browser.
templ clock(p TodayPage) {
	<time id="clock" data-tz={ p.Now.Location().String() } data-offset={ p.Now.Format("-07:00") } data-h24={ strconv.FormatBool(p.Clock24) } data-midnight-in={ strconv.Itoa(p.MidnightIn) }>{ p.Clock }</time>
}

// ticker runs a page's day in the browser, with no request: it ticks #clock
// each second, greys each event once its data-end has passed, and when #clock's
// data-midnight-in seconds are up dispatches refresh-live, so the page refetches
// and turns the day. A refetched #clock is a new element and starts its own count.
templ ticker() {
	<script>
	(() => {
		let seen, due;
		setInterval(() => {
			const clock = document.getElementById("clock");
			if (!clock) return;
			const opts = clock.dataset.h24 === "true" ? { hour: "2-digit", minute: "2-digit", hourCycle: "h23" } : { hour: "numeric", minute: "2-digit", hourCycle: "h12" };
			let at = new Date();
			try { opts.timeZone = clock.dataset.tz; new Intl.DateTimeFormat("en-US", opts); } catch {
				// A zone the browser can't name (Go's "Local"): the household's offset at render, shown as UTC.
				// shortcut: a DST change before the next refetch (at midnight) shows an hour off until then; send a named zone if that bites.
				const [, sign, h, m] = /([+-])(\d\d):(\d\d)/.exec(clock.dataset.offset) || [, "+", "00", "00"];
				at = new Date(at.getTime() + (sign === "-" ? -1 : 1) * (h * 60 + Number(m)) * 6e4); // minutes to ms
				opts.timeZone = "UTC";
			}
			// en-US with plain spaces matches the server's clockLayout (15:04 or 3:04 PM).
			clock.textContent = at.toLocaleTimeString("en-US", opts).replace(/\s/g, " ");
			const now = Date.now();
			if (clock !== seen) {
				seen = clock;
				due = Number(clock.dataset.midnightIn) > 0 ? now + Number(clock.dataset.midnightIn) * 1000 : 0;
			} else if (due && now >= due) {
				due = 0;
				document.dispatchEvent(new Event("refresh-live"));
			}
			for (const li of document.querySelectorAll("[data-end]")) {
				if (Number(li.dataset.end) <= now) {
					li.classList.add("past");
					li.style.opacity = ".5";
				}
			}
		}, 1000);
	})();
	</script>
}
