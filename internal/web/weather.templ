package web

import (
	"context"
	"strconv"
)

// WeatherPill is the cached weather the slim pill shows (spec §8).
type WeatherPill struct {
	Current   int    // rounded
	Unit      string // "C" or "F"
	HasToday  bool   // the cache has today's high and low
	High, Low int
}

// WeatherHeader is the cached weather Today's large header shows.
type WeatherHeader struct {
	WeatherPill
	Conditions string       // e.g. "Overcast"; "" for an unknown code
	Ahead      []WeatherDay // up to 5 days after today
}

type WeatherDay struct {
	Day        string // "Mon"
	Conditions string
	High, Low  int
}

// Weather is the Weather section of Settings.
type Weather struct {
	Lat, Lon    string // blank: no weather
	Place       string // the picked place's name; "" for coordinates
	Units       string // "metric" or "imperial"
	LastSuccess string
	Failures    int
	LastError   string
}

type pillKey struct{}

// WithWeatherPill gives the pages rendered with ctx their pill; nil for none.
func WithWeatherPill(ctx context.Context, p *WeatherPill) context.Context {
	return context.WithValue(ctx, pillKey{}, p)
}

func deg(n int) string { return strconv.Itoa(n) + "°" }

templ weatherPill() {
	if p, _ := ctx.Value(pillKey{}).(*WeatherPill); p != nil {
		<aside aria-label="Weather" class="ml-auto rounded-full bg-soft px-3 py-1 tabular-nums min-[760px]:px-4 min-[760px]:py-1.5 min-[760px]:text-lg">
			{ deg(p.Current) + p.Unit }
			if p.HasToday {
				· H { deg(p.High) } L { deg(p.Low) }
			}
		</aside>
	}
}

templ WeatherSection(w Weather) {
	<section class="card flex flex-col gap-3">
		<h2>Weather</h2>
		<p class="text-muted">Weather from Open-Meteo. Search for your town or city, then pick it from the list.</p>
		@syncStatus(w.LastSuccess, w.Failures, w.LastError)
		<p>
			<span class="text-muted">Showing weather for</span>
			switch {
				case w.Lat == "":
					<strong>nowhere (weather is off)</strong>
				case w.Place != "":
					<strong>{ w.Place }</strong>
				default:
					<strong>{ w.Lat }, { w.Lon }</strong>
			}
		</p>
		<form method="get" action="/settings/weather/places" hx-get="/settings/weather/places" hx-target="#place-results" class="flex flex-wrap items-end gap-2">
			<label class="grow">Find a place <input name="q" type="search" required placeholder="e.g. London" autocomplete="off"/></label>
			<button class="btn-primary">Search</button>
		</form>
		<div id="place-results" aria-live="polite"></div>
		<form method="post" action="/settings/weather" class="flex flex-wrap items-end gap-2">
			<input type="hidden" name="lat" value={ w.Lat }/>
			<input type="hidden" name="lon" value={ w.Lon }/>
			<input type="hidden" name="place" value={ w.Place }/>
			<label>
				Units
				<select name="units">
					<option value="metric" selected?={ w.Units != "imperial" }>Metric (°C)</option>
					<option value="imperial" selected?={ w.Units == "imperial" }>Imperial (°F)</option>
				</select>
			</label>
			<button class="btn-primary">Save units</button>
		</form>
		if w.Lat != "" {
			<form method="post" action="/settings/weather">
				<input type="hidden" name="units" value={ w.Units }/>
				<button class="text-muted underline">Turn weather off</button>
			</form>
		}
	</section>
}

// Place is one place search result.
type Place struct {
	Name     string // "London, England, United Kingdom"
	Lat, Lon string
}

// PlaceResults is a place search's answer: Places, or a Message when none.
type PlaceResults struct {
	Places  []Place
	Message string
	Units   string // kept when a place is picked
}

templ PlaceList(res PlaceResults) {
	if res.Message != "" {
		<p class="text-muted">{ res.Message }</p>
	}
	if len(res.Places) > 0 {
		<ul class="flex flex-col gap-1">
			for _, p := range res.Places {
				<li>
					<form method="post" action="/settings/weather">
						<input type="hidden" name="lat" value={ p.Lat }/>
						<input type="hidden" name="lon" value={ p.Lon }/>
						<input type="hidden" name="place" value={ p.Name }/>
						<input type="hidden" name="units" value={ res.Units }/>
						<button class="pick w-full text-left hover:bg-soft">{ p.Name }</button>
					</form>
				</li>
			}
		</ul>
	}
}
