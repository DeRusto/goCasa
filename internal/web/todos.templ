package web

import "strconv"

type Todo struct {
	ID       int64
	ColumnID int64
	Title    string
	Notes    string
	Due      string // YYYY-MM-DD or ""
	Done     bool
	Overdue  bool

	// Repeat is "" or a preset (daily, weekly, monthly, yearly), every Interval,
	// weekly on ByDay (MO…SU); its next due date counts from the schedule
	// unless FromCompletion.
	Repeat, Interval string
	ByDay            map[string]bool
	FromCompletion   bool
}

type TodoColumn struct {
	ID    int64
	Name  string
	Todos []Todo
}

// TodosPage is the to-do board with its filter. Dragging is offered only on
// the plain board (manual order, open to-dos, no due filter), where a column
// shows every to-do whose place it would set.
type TodosPage struct {
	Columns                     []TodoColumn
	Status, Due, From, To, Sort string
	Draggable                   bool
}

// TodosBoard's columns sit side by side (one column on a phone); its filter and its
// board settings each sit in a flyout off the header.
templ TodosBoard(p TodosPage) {
	@page("To-dos", false) {
		<main>
			@pageHead("To-dos") {
				<button popovertarget="todos-filter" class="rounded-full">Filter</button>
				@menuButton("todos-menu", "To-do settings")
			}
			<div id="todos-filter" popover class="flyout flyout-menu">
				<h2>Filter</h2>
				<form method="get" action="/todos" class="flex flex-col items-start gap-3">
					<label>
						Show
						<select name="status">
							@option("open", "Open", p.Status)
							@option("done", "Completed", p.Status)
							@option("all", "All", p.Status)
						</select>
					</label>
					<label>
						Due
						<select name="due">
							@option("", "Any time", p.Due)
							@option("overdue", "Overdue", p.Due)
							@option("today", "Today or earlier", p.Due)
							@option("week", "Within 7 days", p.Due)
							@option("none", "No due date", p.Due)
						</select>
					</label>
					<div class="flex flex-wrap gap-3">
						<label>From <input type="date" name="from" value={ p.From }/></label>
						<label>To <input type="date" name="to" value={ p.To }/></label>
					</div>
					<label>
						Sort
						<select name="sort">
							@option("", "My order", p.Sort)
							@option("due", "Due date", p.Sort)
						</select>
					</label>
					<button class="btn-primary">Apply</button>
				</form>
			</div>
			<div id="todos-menu" popover class="flyout flyout-menu">
				@defaultViewButton("/todos")
				<form method="post" action="/todo-columns">
					<label>Column name <input name="name" required maxlength="50"/></label>
					<button class="btn-primary">Add column</button>
				</form>
			</div>
			<div id="live" { live(KindTodo, KindMember, KindHousehold)... } class="grid grid-cols-[repeat(auto-fill,minmax(min(20rem,100%),1fr))] items-start gap-4">
				for _, c := range p.Columns {
					<section data-column={ strconv.FormatInt(c.ID, 10) } class="card flex flex-col gap-3">
						<div class="flex items-center justify-between gap-2">
							<h2>{ c.Name }</h2>
							<button popovertarget={ "column-" + strconv.FormatInt(c.ID, 10) } aria-label={ "Column " + c.Name } class="icon-btn border-0 text-xl text-muted">⋯</button>
						</div>
						<div id={ "column-" + strconv.FormatInt(c.ID, 10) } popover class="flyout">
							<h2>Column</h2>
							<form method="post" action={ templ.SafeURL("/todo-columns/" + strconv.FormatInt(c.ID, 10)) }>
								<label>Name <input name="name" required maxlength="50" value={ c.Name }/></label>
								<button class="btn-primary">Rename</button>
							</form>
							<form method="post" action={ templ.SafeURL("/todo-columns/" + strconv.FormatInt(c.ID, 10) + "/delete") } onsubmit="return confirm('Delete this column and all its to-dos?')">
								<button class="btn-danger">Delete column</button>
							</form>
						</div>
						// The title link comes first and the due date is a bare span: the tests read them so.
						<ul class="todos flex flex-col gap-1.5" data-drag="todos">
							for i, t := range c.Todos {
								<li data-todo={ strconv.FormatInt(t.ID, 10) } class={ "flex flex-wrap items-center gap-x-2 rounded-lg bg-soft py-1 pr-1 pl-3 [&>span]:text-sm", templ.KV("[&>span]:text-late", t.Overdue), templ.KV("[&>span]:text-muted", !t.Overdue), templ.KV("opacity-60", t.Done) }>
									<a href={ templ.SafeURL("/todos/" + strconv.FormatInt(t.ID, 10)) } class={ "min-w-0 flex-1 py-2 text-ink", templ.KV("line-through", t.Done) }>{ t.Title }</a>
									if t.Due != "" {
										<span>
											due { t.Due }
											if t.Overdue {
												(overdue)
											}
										</span>
									}
									if t.Done {
										<form method="post" action={ templ.SafeURL("/todos/" + strconv.FormatInt(t.ID, 10) + "/reopen") }><button class="rounded-full">Re-open</button></form>
									} else {
										<form method="post" action={ templ.SafeURL("/todos/" + strconv.FormatInt(t.ID, 10) + "/complete") }><button class="rounded-full">Done</button></form>
									}
									if p.Draggable {
										<span class="handle order-first -ml-1 grid h-11 w-6 place-items-center text-muted" aria-hidden="true">⠿</span>
										if i > 0 {
											@todoMove(c, i, i-1, "↑", "Move up ")
										}
										if i < len(c.Todos)-1 {
											@todoMove(c, i, i+1, "↓", "Move down ")
										}
									}
								</li>
							}
						</ul>
						<form method="post" action="/todos" class="flex flex-wrap items-center gap-2">
							<input type="hidden" name="column_id" value={ strconv.FormatInt(c.ID, 10) }/>
							<label class="min-w-0 flex-1"><span class="sr-only">New to-do</span> <input name="title" required maxlength="200" placeholder="New to-do" class="w-full"/></label>
							<label><span class="sr-only">Due</span> <input type="date" name="due_date"/></label>
							<button class="btn-primary">Add</button>
						</form>
					</section>
				}
			</div>
		</main>
		if p.Draggable {
			@sortable()
		}
		@liveDrafts()
	}
}

func repeatFrom(t Todo) string {
	if t.FromCompletion {
		return "completion"
	}
	return ""
}

templ option(value, label, selected string) {
	<option value={ value } selected?={ value == selected }>{ label }</option>
}

// todoMove is a keyboard-operable button moving column c's to-do i to j.
templ todoMove(c TodoColumn, i, j int, arrow, label string) {
	<form method="post" action="/todos/reorder" class="kbd-move">
		<input type="hidden" name="column_id" value={ strconv.FormatInt(c.ID, 10) }/>
		for _, id := range swapped(c.Todos, i, j) {
			<input type="hidden" name="ids" value={ id }/>
		}
		<button aria-label={ label + c.Todos[i].Title }>{ arrow }</button>
	</form>
}

// swapped is the ids of todos with i and j swapped.
func swapped(todos []Todo, i, j int) []string {
	ids := make([]string, len(todos))
	for k, t := range todos {
		ids[k] = strconv.FormatInt(t.ID, 10)
	}
	ids[i], ids[j] = ids[j], ids[i]
	return ids
}

// TodoEditPage edits one to-do; it can move to another column.
templ TodoEditPage(t Todo, columns []TodoColumn) {
	@layout("To-do") {
		<main>
			<p><a href="/todos">‹ To-dos</a></p>
			<form method="post" action={ templ.SafeURL("/todos/" + strconv.FormatInt(t.ID, 10)) } class="form-card">
				<h1>To-do</h1>
				<label>Title <input name="title" required maxlength="200" value={ t.Title }/></label>
				<div class="flex flex-wrap gap-4">
					<label>
						Column
						<select name="column_id">
							for _, c := range columns {
								<option value={ strconv.FormatInt(c.ID, 10) } selected?={ c.ID == t.ColumnID }>{ c.Name }</option>
							}
						</select>
					</label>
					<label>Due <input type="date" name="due_date" value={ t.Due }/></label>
				</div>
				<fieldset>
					<legend>Repeats</legend>
					<select name="repeat" aria-label="Repeats">
						for _, o := range [][2]string{{"", "Doesn't repeat"}, {"daily", "Daily"}, {"weekly", "Weekly"}, {"monthly", "Monthly"}, {"yearly", "Yearly"}} {
							<option value={ o[0] } selected?={ o[0] == t.Repeat }>{ o[1] }</option>
						}
					</select>
					<label>Every <input type="number" name="interval" min="1" max="999" value={ t.Interval } placeholder="1" class="w-20"/></label>
					<div class="flex w-full flex-wrap gap-2">
						for _, d := range []string{"MO", "TU", "WE", "TH", "FR", "SA", "SU"} {
							<label class="pick"><input type="checkbox" name="byday" value={ d } checked?={ t.ByDay[d] }/> { d }</label>
						}
					</div>
					<label>
						Next due counts from
						<select name="repeat_from">
							@option("", "the schedule", repeatFrom(t))
							@option("completion", "completion", repeatFrom(t))
						</select>
					</label>
				</fieldset>
				<label class="w-full flex-col items-stretch">Notes <textarea name="notes" maxlength="5000">{ t.Notes }</textarea></label>
				<button class="btn-primary">Save</button>
			</form>
			<form method="post" action={ templ.SafeURL("/todos/" + strconv.FormatInt(t.ID, 10) + "/delete") } onsubmit="return confirm('Delete this to-do?')">
				<button class="btn-danger">Delete</button>
			</form>
		</main>
	}
}
