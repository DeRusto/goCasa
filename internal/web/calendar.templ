package web

import (
	"cmp"
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"time"
)

// CalendarInfo is a local calendar as the pages show it.
type CalendarInfo struct {
	ID    int64
	Name  string
	Color string
}

// CalendarEvent is one event as one day shows it.
type CalendarEvent struct {
	ID       int64 // a Series' for its Occurrences
	Original int64 // an Occurrence's key; 0 for a single event
	Title    string
	Time     string   // "09:00–10:00", "22:00–…" or "All day"
	Colors   []string // its Members', else its calendar's
	ReadOnly bool     // from a calendar feed: no edit link
	Synced   bool     // from Google: links to its Members
	Past     bool     // over already; only Today greys these
	End      int64    // a timed event's end, unix ms, for the browser to grey it then; 0 all-day
	Members  []int64  // in Colors' order; none for a calendar's own colour

	// Where the time grid draws it: minutes past this day's midnight, clipped to the day,
	// and its Lane of Lanes among the events it overlaps.
	AllDay          bool
	From, To        int
	Lane, Lanes     int
	ContinuesBefore bool // all-day, from an earlier day
	ContinuesAfter  bool // all-day, into a later day
}

// StaleCalendar is a shown calendar that isn't syncing.
type StaleCalendar struct {
	Name        string
	LastUpdated string // when it last synced, or "never"
	Reconnect   bool   // its Google account needs reconnecting
}

// SyncedEvent is a Google event as its Members page shows it.
type SyncedEvent struct {
	ID      int64
	Title   string
	When    string
	Members map[int64]bool
}

type CalendarDay struct {
	Date   time.Time
	Today  bool
	Faded  bool // outside the month a month view shows
	Events []CalendarEvent
}

type CalendarPage struct {
	View              string // month, week, day or agenda
	Date              time.Time
	Days              []CalendarDay // agenda: only days with events
	Users             map[int64]bool
	Members           []Member
	Calendars         []CalendarInfo
	Prev, Next, Today string
	Clock24           bool
	NowMin            int // minutes past the household's midnight, for the time grid's now line
	ViewLinks         map[string]string
	DefaultView       string // this view and Member filter, at today
	ICS               string // the absolute ICS export URL, for all calendars
	Stale             []StaleCalendar
	BeyondGoogle      bool // the view reaches past the 12 months of Google events kept
}

// EventForm is the event dialog's fields; ID 0 is a new event.
type EventForm struct {
	ID                           int64
	CalendarID                   int64
	Title, Location, Description string
	AllDay                       bool
	Start, End, TZ               string // timed, in TZ
	StartDate, EndDate           string // all-day, last day inclusive
	Members                      map[int64]bool
	Occurrence                   int64  // set: an edit of Series ID's Occurrence
	Scope                        string // an Occurrence's edit scope: this, following or all
	Reset                        int    // One-off edits a This and following edit resets, once confirmed
	Repeat                       string // "", daily, weekly, monthly, yearly or custom
	Interval                     string
	ByDay                        map[string]bool // weekly: MO…SU
	Custom                       string          // RRULE, EXDATE and RDATE lines
	Synced                       bool            // a Google event: changes go to Google first
	InSeries                     bool            // a Google occurrence, with edit scopes
	Etag                         string          // a Google event's version as shown, to refuse a stale change
}

// scoped reports whether f edits an Occurrence of a Series, in an edit scope.
func (f EventForm) scoped() bool { return f.Occurrence != 0 || f.InSeries }

// occurrenceQuery is the ?occurrence= an Occurrence's links carry.
func occurrenceQuery(original int64) string {
	if original == 0 {
		return ""
	}
	return "?occurrence=" + id(original)
}

func id(n int64) string { return strconv.FormatInt(n, 10) }

func calendarTitle(p CalendarPage) string {
	switch p.View {
	case "day":
		return p.Date.Format("Monday 2 January 2006")
	case "week":
		return "Week of " + p.Days[0].Date.Format("2 January 2006")
	case "agenda":
		return "From " + p.Date.Format("2 January 2006")
	}
	return p.Date.Format("January 2006")
}

func eventURL(f EventForm, action string) templ.SafeURL {
	switch {
	case f.ID == 0:
		return "/calendar/event"
	case f.Synced:
		return templ.SafeURL("/calendar/synced/" + id(f.ID) + cmp.Or(action, "/edit"))
	}
	return templ.SafeURL("/calendar/event/" + id(f.ID) + action + occurrenceQuery(f.Occurrence))
}

func newEventURL(d time.Time) templ.SafeURL {
	return templ.SafeURL("/calendar/event/new?date=" + d.Format("2006-01-02"))
}

templ swatches(colors []string) {
	for _, c := range colors {
		<span aria-hidden="true" style={ "display:inline-block;width:.7em;height:.7em;border-radius:50%;background:" + c }></span>
	}
}

// pastel is colour c blended into the card, so a Member's strong colour reads as
// a pastel in either theme.
func pastel(c string) string { return "color-mix(in oklab, " + c + " 30%, var(--color-card))" }

// eventFill is an event's background: its colour's pastel, or diagonal stripes of
// each colour's for several. Colours are #rrggbb (the database checks), so the CSS is safe.
func eventFill(colors []string) templ.SafeCSS {
	switch len(colors) {
	case 0:
		return "background:var(--color-soft);"
	case 1:
		return templ.SafeCSS("background:" + pastel(colors[0]) + ";")
	}
	var b strings.Builder
	for i, c := range colors {
		fmt.Fprintf(&b, ", %s %dpx %dpx", pastel(c), i*16, (i+1)*16)
	}
	return templ.SafeCSS("background:repeating-linear-gradient(135deg" + b.String() + ");")
}

templ calendarDay(d CalendarDay, heading string) {
	<section data-date={ d.Date.Format("2006-01-02") } class={ templ.KV("opacity-50", d.Faded) }>
		<h3 class="flex items-center justify-between gap-2">
			if d.Today {
				<strong class="text-accent">{ heading }</strong>
			} else {
				{ heading }
			}
			<a href={ newEventURL(d.Date) } aria-label={ "New event on " + d.Date.Format("2 January") } class="grid size-11 place-items-center rounded-full text-2xl font-normal text-muted no-underline hover:bg-soft hover:no-underline">+</a>
		</h3>
		<ul class="flex flex-col gap-1.5">
			for _, e := range d.Events {
				<li
					class={ "flex rounded-lg px-3 py-2", templ.KV("past", e.Past) }
					style={ eventFill(e.Colors) }
					if e.End != 0 {
						data-end={ strconv.FormatInt(e.End, 10) }
					}
				>
					if e.Synced {
						<a href={ templ.SafeURL("/calendar/synced/" + id(e.ID)) } title="From Google" class={ eventText }>@eventLabel(e)</a>
					} else if e.ReadOnly {
						<span title="From a calendar feed: read-only" class={ eventText }>@eventLabel(e)</span>
					} else {
						<a href={ templ.SafeURL("/calendar/event/" + id(e.ID) + occurrenceQuery(e.Original)) } class={ eventText }>@eventLabel(e)</a>
					}
				</li>
			}
		</ul>
	</section>
}

const eventText = "flex flex-1 flex-wrap gap-x-2.5 text-ink no-underline"

templ eventLabel(e CalendarEvent) {
	<span class="w-28 flex-none text-muted tabular-nums">{ e.Time }</span> <span>{ e.Title }</span>
}

// Calendar is the main calendar page in one of its four views.
templ Calendar(p CalendarPage) {
	@page("Calendar", false) {
		// On a phone the header packs into a title line and one sideways-scrolling row of controls.
		<main class="h-[calc(100dvh-4rem)] max-[759px]:gap-2 max-[759px]:p-3 min-[760px]:h-dvh">
			<div class="flex flex-none flex-wrap items-center gap-x-4 gap-y-2">
				<h1 class="text-xl font-normal min-[760px]:text-3xl">{ calendarTitle(p) }</h1>
				@weatherPill()
			</div>
			<div class="flex flex-none flex-wrap items-center gap-2 max-[759px]:-mx-3 max-[759px]:flex-nowrap max-[759px]:overflow-x-auto max-[759px]:px-3 max-[759px]:[scrollbar-width:none] max-[759px]:[&>*]:flex-none">
				<nav class="flex gap-1">
					<a href={ templ.SafeURL(p.Prev) } class={ chip } aria-label="Previous">‹</a>
					<a href={ templ.SafeURL(p.Today) } class={ chip }>Today</a>
					<a href={ templ.SafeURL(p.Next) } class={ chip } aria-label="Next">›</a>
				</nav>
				<nav class="flex rounded-full border border-line bg-card p-1">
					for _, v := range []string{"month", "week", "day", "agenda"} {
						<a
							href={ templ.SafeURL(p.ViewLinks[v]) }
							if v == p.View {
								aria-current="page"
							}
							class="flex min-h-10 items-center rounded-full px-3 text-ink capitalize min-[760px]:px-4 no-underline hover:no-underline aria-[current=page]:bg-accent-soft"
						>{ v }</a>
					}
				</nav>
				<form method="get" action="/calendar" class="flex flex-wrap items-center gap-2 max-[759px]:flex-nowrap" onchange="this.requestSubmit()">
					<input type="hidden" name="view" value={ p.View }/>
					<input type="hidden" name="date" value={ p.Date.Format("2006-01-02") }/>
					<fieldset class="contents">
						<legend class="sr-only">Show Members (Household events always show)</legend>
						for _, m := range p.Members {
							<label class="member-chip max-[759px]:pr-1" style={ memberChip(m) }>
								<input type="checkbox" name="users" value={ id(m.ID) } checked?={ p.Users[m.ID] } class="sr-only"/>
								@avatar(m)
								<span class="max-[759px]:sr-only">{ m.Name }</span>
							</label>
						}
						<button class="sr-only">Filter</button>
					</fieldset>
				</form>
				<button popovertarget="calendar-menu" aria-label="Calendar settings" class="ml-auto grid size-11 place-items-center rounded-full p-0">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true">
						@templ.Raw(navPages[len(navPages)-1].Icon)
					</svg>
				</button>
			</div>
			// The header above stays put; this scrolls, and keeps its place across live refetches of #live.
			<div class="relative -mx-5 -mb-5 flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto px-5 pb-5 max-[759px]:-mx-3 max-[759px]:-mb-3 max-[759px]:px-3 max-[759px]:pb-3" data-scroll>
				<div id="live" { live(KindEvent, KindMember, KindHousehold, KindIntegration)... } hx-select-oob="#calendar-list" class={ "flex flex-col gap-4", templ.KV("h-full", p.View == "month") }>
					for _, s := range p.Stale {
						<p role="status">
							{ s.Name }: last updated { s.LastUpdated }.
							if s.Reconnect {
								Reconnect needed: an Admin reconnects its Google account in Settings.
							} else {
								Syncing keeps failing; Settings has the details.
							}
						</p>
					}
					if p.BeyondGoogle {
						<p role="status">Google events more than 12 months ahead aren't shown.</p>
					}
					switch p.View {
						case "month":
							<table class="card grid h-full min-h-[36rem] grid-cols-7 auto-rows-[minmax(0,1fr)] grid-rows-[auto] p-0 [&_tbody]:contents [&_thead]:contents [&_tr]:contents">
								<thead>
									<tr>
										for _, d := range p.Days[:7] {
											<th>{ d.Date.Format("Mon") }</th>
										}
									</tr>
								</thead>
								<tbody>
									for w := 0; w < len(p.Days); w += 7 {
										<tr>
											for _, d := range p.Days[w : w+7] {
												<td class="min-h-0 overflow-hidden border-t border-l border-line p-1.5 [&:nth-child(7n+1)]:border-l-0">
													@monthDay(d, dayURL(p, d.Date))
												</td>
											}
										</tr>
									}
								</tbody>
							</table>
						case "agenda":
							<div class="card flex flex-col gap-5">
								for _, d := range p.Days {
									@calendarDay(d, d.Date.Format("Monday 2 January"))
								}
								if len(p.Days) == 0 {
									<p class="text-muted">Nothing on the calendar for these days.</p>
								}
							</div>
						default:
							@timeGrid(p)
					}
				</div>
			</div>
			<div id="calendar-menu" popover class="inset-auto top-32 right-6 m-0 w-96 max-w-[calc(100vw-2rem)] flex-col gap-4 rounded-[14px] border border-line bg-card p-4 text-ink shadow-xl [&:popover-open]:flex">
				<div class="flex flex-wrap gap-2">
					<form method="post" action="/calendar/sync">
						<input type="hidden" name="back" value={ p.ViewLinks[p.View] }/>
						<button>Sync now</button>
					</form>
					@defaultViewButton(p.DefaultView)
				</div>
				<section id="calendar-list" class="flex flex-col gap-2">
					<h2>Calendars</h2>
					<ul class="flex flex-col gap-1">
						for _, c := range p.Calendars {
							<li class="flex items-center gap-2">
								@swatches([]string{c.Color})
								{ c.Name }
								<a href={ templ.SafeURL(p.ICS + "?calendars=" + strconv.FormatInt(c.ID, 10)) } class="ml-auto">ICS</a>
							</li>
						}
					</ul>
					if len(p.Calendars) > 0 {
						<p class="text-sm break-all">Subscribe to every calendar: <a href={ templ.SafeURL(p.ICS) }>{ p.ICS }</a></p>
					}
				</section>
				<form method="post" action="/calendar/calendars" class="flex flex-wrap items-end gap-2">
					<label>Name <input name="name" required maxlength="50" class="w-40"/></label>
					<label>Colour <input type="color" name="color" value="#a855f7" class="w-14 px-1"/></label>
					<button>Add calendar</button>
				</form>
			</div>
			<a href={ newEventURL(p.Date) } class="fixed right-6 bottom-20 z-30 grid size-16 place-items-center rounded-full bg-accent text-4xl font-light text-on-accent no-underline shadow-lg hover:no-underline min-[760px]:bottom-6">
				<span aria-hidden="true">+</span>
				<span class="sr-only">New event</span>
			</a>
		</main>
		@liveDrafts()
		@timeGridScript()
	}
}

const chip = "flex min-h-11 min-w-11 items-center justify-center rounded-full border border-line bg-card px-4 text-xl text-ink no-underline hover:bg-soft hover:no-underline"

// monthShown is how many events a month day lists before "+N more".
const monthShown = 3

// monthDay is a day of the month view: a few one-line events, the rest behind a
// link to its day, so every day stays its box's size and the month fits a screen.
templ monthDay(d CalendarDay, more string) {
	<section data-date={ d.Date.Format("2006-01-02") } class={ "flex h-full flex-col gap-0.5 text-sm", templ.KV("opacity-50", d.Faded) }>
		<h3 class="flex items-center justify-between font-normal">
			if d.Today {
				<strong class="grid size-7 place-items-center rounded-full bg-now text-white">{ d.Date.Format("2") }</strong>
			} else {
				<span class="grid size-7 place-items-center">{ d.Date.Format("2") }</span>
			}
			<a href={ newEventURL(d.Date) } aria-label={ "New event on " + d.Date.Format("2 January") } class="grid size-7 place-items-center rounded-full text-lg text-muted no-underline hover:bg-soft hover:no-underline">+</a>
		</h3>
		<ul class="flex min-h-0 flex-col gap-0.5">
			for i, e := range d.Events {
				if i < monthShown {
					<li class="flex">
						@eventLink(e, "flex min-w-0 flex-1 gap-1.5 truncate rounded-md px-1.5 py-0.5 text-ink no-underline hover:no-underline") {
							<span class="sr-only">{ e.Time }</span> <span class="truncate">{ e.Title }</span>
							<span aria-hidden="true" class="order-first text-muted tabular-nums empty:hidden">{ startLabel(e) }</span>
						}
					</li>
				}
			}
		</ul>
		if n := len(d.Events) - monthShown; n > 0 {
			<a href={ templ.SafeURL(more) } class="mt-auto px-1.5 text-xs text-muted">+{ strconv.Itoa(n) } more</a>
		}
	</section>
}

// startLabel is a timed event's start as its Time shows it; "" all-day or from an earlier day.
func startLabel(e CalendarEvent) string {
	if e.AllDay {
		return ""
	}
	start, _, _ := strings.Cut(e.Time, "–")
	return strings.TrimSuffix(start, "…")
}

// dayURL is the day view of d, keeping the page's Member filter.
func dayURL(p CalendarPage, d time.Time) string {
	u, err := url.Parse(p.ViewLinks["day"])
	if err != nil {
		return p.ViewLinks["day"]
	}
	q := u.Query()
	q.Set("date", d.Format("2006-01-02"))
	u.RawQuery = q.Encode()
	return u.String()
}

// hourRem is each hour's height on the time grid.
const hourRem = 5.0

func remAt(min int) string { return strconv.FormatFloat(float64(min)*hourRem/60, 'f', 3, 64) + "rem" }

// MinBlockMinutes is the least a timed event is drawn as on the time grid, so a
// short one stays readable; lanes keeps its lane taken that long too.
const MinBlockMinutes = 21

// blockStyle places a timed event on its day's column: by its minutes down, and
// across by its Lane.
func blockStyle(e CalendarEvent) templ.SafeCSS {
	lanes := max(e.Lanes, 1)
	return templ.SafeCSS(fmt.Sprintf("top:%s;height:%s;left:%.4f%%;width:%.4f%%;",
		remAt(e.From), remAt(max(e.To-e.From, MinBlockMinutes)), 100*float64(e.Lane)/float64(lanes), 100/float64(lanes)))
}

// allDayRows makes every day column's header as tall as the one with the most all-day events.
func allDayRows(days []CalendarDay) templ.SafeCSS {
	most := 0
	for _, d := range days {
		n := 0
		for _, e := range d.Events {
			if e.AllDay {
				n++
			}
		}
		most = max(most, n)
	}
	return templ.SafeCSS(fmt.Sprintf("min-height:calc(3.5rem + %d * 2rem);", most))
}

func hourLabel(h int, clock24 bool) string {
	if clock24 {
		return fmt.Sprintf("%02d:00", h)
	}
	return time.Date(0, 1, 1, h, 0, 0, 0, time.UTC).Format("3 PM")
}

func memberIndex(ms []Member) map[int64]Member {
	idx := make(map[int64]Member, len(ms))
	for _, m := range ms {
		idx[m.ID] = m
	}
	return idx
}

// timeGrid is the week and day views: a column per day, all-day events across the
// top and timed events placed by the clock, with a line at now on today.
// shortcut: a multi-day bar can sit on a different row on each day when the days'
// other all-day events differ; give all-day events fixed rows if that bites.
templ timeGrid(p CalendarPage) {
	{{ members := memberIndex(p.Members) }}
	<div class="card flex min-w-fit p-0">
		<div class="w-16 flex-none">
			<div class="sticky top-0 z-10 rounded-tl-[14px] border-b border-line bg-card" style={ allDayRows(p.Days) }></div>
			<div class="relative" style={ templ.SafeCSS("height:" + remAt(24*60) + ";") }>
				for h := 1; h < 24; h++ {
					<span class="absolute right-2 -translate-y-1/2 text-xs whitespace-nowrap text-muted" style={ templ.SafeCSS("top:" + remAt(h*60) + ";") }>{ hourLabel(h, p.Clock24) }</span>
				}
			</div>
		</div>
		for _, d := range p.Days {
			<section data-date={ d.Date.Format("2006-01-02") } class="min-w-28 flex-1 border-l border-line">
				<div class="sticky top-0 z-10 flex flex-col gap-1 border-b border-line bg-card px-2 py-2" style={ allDayRows(p.Days) }>
					<h3 class="flex items-center gap-2 text-xl font-normal">
						{ d.Date.Format("Mon") }
						if d.Today {
							<span class="grid size-8 place-items-center rounded-full bg-now text-base font-semibold text-white">{ d.Date.Format("2") }</span>
						} else {
							{ d.Date.Format("2") }
						}
					</h3>
					<ul class="flex flex-col gap-1">
						for _, e := range d.Events {
							if e.AllDay {
								<li class={ "flex", templ.KV("-ml-2", e.ContinuesBefore), templ.KV("-mr-2", e.ContinuesAfter) }>
									@eventLink(e, "flex-1 truncate px-2 py-0.5 text-sm text-ink no-underline hover:no-underline "+allDayEnds(e)) {
										<span class="sr-only">{ e.Time }</span> <span>{ e.Title }</span>
									}
								</li>
							}
						}
					</ul>
				</div>
				<ul class="relative bg-[repeating-linear-gradient(to_bottom,transparent_0_calc(5rem-1px),var(--color-line)_calc(5rem-1px)_5rem)]" style={ templ.SafeCSS("height:" + remAt(24*60) + ";") } data-grid-body>
					for _, e := range d.Events {
						if !e.AllDay {
							<li class="absolute p-0.5" style={ blockStyle(e) }>
								@eventLink(e, "flex h-full flex-col gap-0.5 overflow-hidden rounded-xl px-2.5 py-1.5 text-sm text-ink no-underline shadow-sm hover:no-underline") {
									<span class="order-2 text-muted tabular-nums">{ e.Time }</span> <span class="font-medium">{ e.Title }</span>
									if len(e.Members) > 0 {
										<span class="order-3 mt-auto flex justify-end -space-x-1.5 [&_.avatar]:size-6 [&_.avatar]:text-[10px] [&_.avatar]:ring-2 [&_.avatar]:ring-card">
											for i, mid := range e.Members {
												if m, ok := members[mid]; ok && i < 3 {
													@avatar(m)
												}
											}
											if len(e.Members) > 3 {
												<span class="grid size-6 place-items-center rounded-full bg-card text-[10px] font-semibold">+{ strconv.Itoa(len(e.Members) - 3) }</span>
											}
										</span>
									}
								}
							</li>
						}
					}
					if d.Today {
						<li id="now-line" class="pointer-events-none absolute inset-x-0 z-[5] h-0.5 bg-now before:absolute before:-top-1 before:-left-1 before:size-2.5 before:rounded-full before:bg-now" style={ templ.SafeCSS("top:" + remAt(p.NowMin) + ";") } data-min={ strconv.Itoa(p.NowMin) } aria-hidden="true"></li>
					}
				</ul>
			</section>
		}
	</div>
}

// allDayEnds rounds an all-day bar only where it starts and ends, so a multi-day
// event reads as one bar across the days.
func allDayEnds(e CalendarEvent) string {
	switch {
	case e.ContinuesBefore && e.ContinuesAfter:
		return ""
	case e.ContinuesBefore:
		return "rounded-r-lg"
	case e.ContinuesAfter:
		return "rounded-l-lg"
	}
	return "rounded-lg"
}

// eventLink is an event's link to its edit page (or its Members, from Google),
// or plain text for a read-only feed event, filled with its colours; class styles it.
templ eventLink(e CalendarEvent, class string) {
	if e.Synced {
		<a href={ templ.SafeURL("/calendar/synced/" + id(e.ID)) } title="From Google" class={ class } style={ eventFill(e.Colors) }>
			{ children... }
		</a>
	} else if e.ReadOnly {
		<span title="From a calendar feed: read-only" class={ class } style={ eventFill(e.Colors) }>
			{ children... }
		</span>
	} else {
		<a href={ templ.SafeURL("/calendar/event/" + id(e.ID) + occurrenceQuery(e.Original)) } class={ class } style={ eventFill(e.Colors) }>
			{ children... }
		</a>
	}
}

// timeGridScript scrolls the time grid's area once, to an hour before now (7am on
// another week), and moves the now line each minute between refetches.
templ timeGridScript() {
	<script>
	(() => {
		const body = document.querySelector("[data-grid-body]");
		if (!body) return;
		const first = document.getElementById("now-line");
		const from = first ? Math.max(Number(first.dataset.min) - 60, 0) : 7 * 60;
		const scroller = body.closest("[data-scroll]");
		scroller.scrollTop = body.getBoundingClientRect().top - scroller.getBoundingClientRect().top + scroller.scrollTop + from * body.offsetHeight / (24 * 60) - 120;
		let seen = first, at = Date.now();
		setInterval(() => {
			const line = document.getElementById("now-line");
			if (!line) return;
			if (line !== seen) { seen = line; at = Date.now(); }
			const min = Math.min(Number(line.dataset.min) + (Date.now() - at) / 6e4, 24 * 60); // ms to minutes
			line.style.top = min * line.parentElement.offsetHeight / (24 * 60) + "px";
		}, 60000);
	})();
	</script>
}

// live makes a page's #live region refetch the page and swap in its new
// content when a change of one of kinds (the change stream's event names) is
// published, on every (re)connect, catching up on missed changes, and on a
// document-level refresh-live event (a page's own timer, e.g. Today's clock).
// Only the region's children are swapped, so it keeps its stream; htmx's SSE
// extension reconnects a dropped one.
func live(kinds ...Kind) templ.Attributes {
	trigger := "htmx:sseOpen, refresh-live from:document"
	for _, k := range kinds {
		trigger += ", sse:" + string(k)
	}
	return templ.Attributes{
		"hx-ext": "sse", "sse-connect": "/events/stream",
		"hx-get": "", "hx-trigger": trigger, "hx-select": "#live > *", "hx-swap": "innerHTML",
		"hx-sync":    "this:replace", // a slower older fetch must not land after a newer one
		"hx-headers": `{"X-Background":"1"}`,
	}
}

// htmx loads the vendored htmx and its SSE extension (see Static).
templ htmx() {
	<script src="/static/htmx-2.0.11.min.js"></script>
	<script src="/static/htmx-ext-sse-2.2.4.js"></script>
}

// sortable lets an item in #live be dragged by its handle, with the vendored
// SortableJS (see Static), within its list or across lists sharing a data-drag
// group; its fallback mode drives mouse and touch alike and auto-scrolls a
// long list. On drop, cancelled or not, what shows is kept: to-do columns post
// their whole order, any other item its new position to its data-move address.
// A live swap waits for the drag to end; each swap gets its lists re-armed.
// Up/down buttons are the keyboard way.
templ sortable() {
	<script src="/static/Sortable-1.15.6.min.js"></script>
	<style>.handle { touch-action: none; cursor: grab; }</style>
	<script>
	(() => {
		const live = document.getElementById("live");
		let dragging = false, deferred = false;
		const post = (url, body) => fetch(url, { method: "POST", redirect: "manual", body });
		const save = e => {
			if (e.from === e.to && e.oldIndex === e.newIndex) return;
			if (e.item.dataset.move) return post(e.item.dataset.move, new URLSearchParams({ position: e.newIndex }));
			for (const ul of new Set([e.from, e.to])) {
				const body = new URLSearchParams({ column_id: ul.closest("section").dataset.column });
				ul.querySelectorAll("li[data-todo]").forEach(li => body.append("ids", li.dataset.todo));
				post("/todos/reorder", body);
			}
		};
		const arm = () => live.querySelectorAll("ul[data-drag]").forEach(ul => Sortable.create(ul, {
			group: ul.dataset.drag, handle: ".handle", forceFallback: true, animation: 150,
			onStart: () => { dragging = true; },
			onEnd: e => {
				dragging = false;
				save(e);
				if (deferred) { deferred = false; document.dispatchEvent(new Event("refresh-live")); }
			},
		}));
		live.addEventListener("htmx:beforeSwap", e => {
			if (dragging) { deferred = true; e.detail.shouldSwap = false; }
		});
		live.addEventListener("htmx:afterSwap", arm);
		arm();
	})();
	</script>
}

// liveDrafts keeps a remote change from wiping a draft: while a form in #live
// is being filled (focused, or holding unsent text, ticks or choices) its swap is cancelled, and
// redone once focus leaves it. A failed refetch is retried, so the page doesn't
// stay stale until the next change.
templ liveDrafts() {
	<script>
	(() => {
		const live = document.getElementById("live");
		const refresh = () => document.dispatchEvent(new Event("refresh-live"));
		const drafting = () => [...live.querySelectorAll("input:not([type=hidden]), textarea, select")].some(el =>
			el === document.activeElement || (
			el.type === "checkbox" || el.type === "radio" ? el.checked !== el.defaultChecked :
			el.tagName === "SELECT" ? [...el.options].some(o => o.selected !== o.defaultSelected) :
			el.value !== el.defaultValue));
		let deferred, retry;
		live.addEventListener("htmx:beforeSwap", e => {
			deferred = drafting();
			if (deferred) e.detail.shouldSwap = false;
		});
		document.addEventListener("focusout", () => setTimeout(() => { if (deferred && !drafting()) refresh(); }));
		const again = () => { clearTimeout(retry); retry = setTimeout(refresh, 5000); };
		live.addEventListener("htmx:responseError", again);
		live.addEventListener("htmx:sendError", again);
	})();
	</script>
}

// SyncedEventPage shows a Google event and changes its Members. Changing them
// here keeps them through later syncs and never reaches Google.
templ SyncedEventPage(e SyncedEvent, members []Member) {
	@layout("Event") {
		<main>
			<p><a href="/calendar">‹ Calendar</a></p>
			<form method="post" action={ templ.SafeURL("/calendar/synced/" + id(e.ID)) } class="form-card">
				<h1>{ e.Title }</h1>
				<p>{ e.When }</p>
				<p class="text-muted">From Google: change it there. Its Members are GoCasa's own.</p>
				@eventMembers(members, e.Members)
				<button class="btn-primary">Save</button>
			</form>
		</main>
	}
}

// eventMembers is an event form's Members, as pastel avatar chips.
templ eventMembers(members []Member, checked map[int64]bool) {
	<fieldset>
		<legend>Members (none: a Household event)</legend>
		for _, m := range members {
			<label class="member-chip" style={ memberChip(m) }>
				<input type="checkbox" name="members" value={ id(m.ID) } checked?={ checked[m.ID] } class="sr-only"/>
				@avatar(m)
				{ m.Name }
			</label>
		}
	</fieldset>
}

// EventPage is the event dialog: create, edit or delete a single event.
templ EventPage(f EventForm, cals []CalendarInfo, members []Member, errMsg string) {
	@layout("Event") {
		<main>
			<p><a href="/calendar">‹ Calendar</a></p>
			@formError(errMsg)
			if len(cals) == 0 {
				<p role="status">Add a calendar on the calendar page first.</p>
			}
			<form method="post" action={ eventURL(f, "") } class="form-card">
				<h1>
					if f.ID == 0 {
						New event
					} else {
						Edit event
					}
				</h1>
				<label class="w-full"><span>Title</span> <input name="title" value={ f.Title } required maxlength="200" class="min-w-0 flex-1"/></label>
				if !f.scoped() && !f.Synced {
					<label>
						Calendar
						<select name="calendar_id" required>
							for _, c := range cals {
								<option value={ id(c.ID) } selected?={ c.ID == f.CalendarID }>{ c.Name }</option>
							}
						</select>
					</label>
				}
				@eventMembers(members, f.Members)
				<label class="pick"><input type="checkbox" name="all_day" checked?={ f.AllDay }/> All day</label>
				<div class="grid w-full gap-4 min-[760px]:grid-cols-2">
					<fieldset>
						<legend>Timed</legend>
						<label>Starts <input type="datetime-local" name="start" value={ f.Start } class="max-w-full"/></label>
						<label>Ends <input type="datetime-local" name="end" value={ f.End } class="max-w-full"/></label>
						<label>Time zone <input name="tz" value={ f.TZ } class="max-w-full"/></label>
					</fieldset>
					<fieldset>
						<legend>All day</legend>
						<label>First day <input type="date" name="start_date" value={ f.StartDate }/></label>
						<label>Last day <input type="date" name="end_date" value={ f.EndDate }/></label>
					</fieldset>
				</div>
				if f.Synced {
					<p class="text-muted">From Google: repeat changes are made in Google.</p>
				} else {
					<fieldset>
						<legend>Repeats</legend>
						<select name="repeat" aria-label="Repeats">
							for _, o := range [][2]string{{"", "Doesn't repeat"}, {"daily", "Daily"}, {"weekly", "Weekly"}, {"monthly", "Monthly"}, {"yearly", "Yearly"}, {"custom", "Custom (advanced)"}} {
								<option value={ o[0] } selected?={ o[0] == f.Repeat }>{ o[1] }</option>
							}
						</select>
						<label>Every <input type="number" name="interval" min="1" max="999" value={ f.Interval } placeholder="1" class="w-20"/></label>
						<div class="flex w-full flex-wrap items-center gap-2">
							<span class="text-sm text-muted">On (weekly)</span>
							for _, d := range []string{"MO", "TU", "WE", "TH", "FR", "SA", "SU"} {
								<label class="pick"><input type="checkbox" name="byday" value={ d } checked?={ f.ByDay[d] }/> { d }</label>
							}
						</div>
						<details open?={ f.Repeat == "custom" } class="w-full">
							<summary class="flex min-h-11 cursor-pointer items-center">Advanced</summary>
							<label class="w-full flex-col items-stretch">RRULE, EXDATE and RDATE lines <textarea name="rrule" placeholder="RRULE:FREQ=MONTHLY;BYDAY=2TU">{ f.Custom }</textarea></label>
						</details>
					</fieldset>
				}
				<label class="w-full"><span>Location</span> <input name="location" value={ f.Location } maxlength="200" class="min-w-0 flex-1"/></label>
				<label class="w-full flex-col items-stretch">Description <textarea name="description" maxlength="5000">{ f.Description }</textarea></label>
				if f.scoped() {
					<fieldset>
						<legend>Change</legend>
						for _, s := range scopes {
							<label class="pick"><input type="radio" name="scope" value={ s[0] } checked?={ s[0] == f.Scope }/> { s[1] }</label>
						}
						<p class="text-sm text-muted">All events changes the title, location, description and Members only. Time and repeat changes use This event or This and following, which starts a new Series here.</p>
					</fieldset>
					if f.Reset > 0 {
						<input type="hidden" name="reset" value={ strconv.Itoa(f.Reset) }/>
					}
					@scopePicker()
				}
				if f.Synced {
					<input type="hidden" name="etag" value={ f.Etag }/>
				}
				<button class="btn-primary">Save</button>
				@savingLabel()
			</form>
			if f.ID != 0 {
				<form method="post" action={ eventURL(f, "/delete") }>
					if f.scoped() {
						for _, s := range scopes {
							<button name="scope" value={ s[0] } class="btn-danger">Delete { strings.ToLower(s[1]) }</button>
						}
					} else {
						<button class="btn-danger">Delete event</button>
					}
					if f.Synced {
						<input type="hidden" name="etag" value={ f.Etag }/>
					}
					@savingLabel()
				</form>
			}
		</main>
	}
}

// savingLabel shows "Saving…" on its form's buttons while it is sent, and
// sends it once: a Google event's change waits for Google and the sync after
// it, and a second click could create the event twice. Buttons aren't
// disabled, which would drop the clicked one's scope.
templ savingLabel() {
	<script>
	(() => {
		const form = document.currentScript.closest("form");
		const labels = [...form.querySelectorAll("button")].map(b => b.textContent);
		let sent = false;
		form.addEventListener("submit", e => {
			if (sent) return e.preventDefault();
			sent = true;
			for (const b of form.querySelectorAll("button")) b.textContent = "Saving…";
		});
		// Back from the next page, the form is usable again.
		addEventListener("pageshow", () => {
			sent = false;
			form.querySelectorAll("button").forEach((b, i) => b.textContent = labels[i]);
		});
	})();
	</script>
}

var scopes = [][2]string{{"this", "This event"}, {"following", "This and following events"}, {"all", "All events"}}

// scopePicker greys out the scopes an edit can't use: This event once the
// repeat changes, All events once the time or repeat does (spec §7.4).
templ scopePicker() {
	<script>
	(() => {
		const form = document.currentScript.closest("form");
		const changed = names => [...form.elements].some(el => names.includes(el.name) && (
			el.type === "checkbox" ? el.checked !== el.defaultChecked :
			el.tagName === "SELECT" ? [...el.options].some(o => o.selected !== o.defaultSelected) :
			el.value !== el.defaultValue));
		form.addEventListener("input", () => {
			const rule = changed(["repeat", "interval", "byday", "rrule"]);
			const time = rule || changed(["all_day", "start", "end", "tz", "start_date", "end_date"]);
			for (const [scope, off] of [["this", rule], ["all", time]]) {
				const el = form.querySelector(`[name=scope][value=${scope}]`);
				el.disabled = off;
				if (off && el.checked) form.querySelector("[name=scope][value=following]").checked = true;
			}
		});
	})();
	</script>
}
