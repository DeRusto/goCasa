package web

import (
	"strconv"
	"strings"
	"time"
)

// CalendarInfo is a local calendar as the pages show it.
type CalendarInfo struct {
	ID    int64
	Name  string
	Color string
}

// CalendarEvent is one event as one day shows it.
type CalendarEvent struct {
	ID       int64 // a Series' for its Occurrences
	Original int64 // an Occurrence's key; 0 for a single event
	Title  string
	Time   string   // "09:00–10:00", "22:00–…" or "All day"
	Colors []string // its Members', else its calendar's
}

type CalendarDay struct {
	Date   time.Time
	Today  bool
	Faded  bool // outside the month a month view shows
	Events []CalendarEvent
}

type CalendarPage struct {
	View              string // month, week, day or agenda
	Date              time.Time
	Days              []CalendarDay // agenda: only days with events
	Users             map[int64]bool
	Members           []Member
	Calendars         []CalendarInfo
	Prev, Next, Today string
	ViewLinks         map[string]string
	ICS               string // the absolute ICS export URL, for all calendars
}

// EventForm is the event dialog's fields; ID 0 is a new event.
type EventForm struct {
	ID                           int64
	CalendarID                   int64
	Title, Location, Description string
	AllDay                       bool
	Start, End, TZ               string // timed, in TZ
	StartDate, EndDate           string // all-day, last day inclusive
	Members                      map[int64]bool
	Occurrence                   int64  // set: an edit of Series ID's Occurrence
	Scope                        string // an Occurrence's edit scope: this, following or all
	Reset                        int    // One-off edits a This and following edit resets, once confirmed
	Repeat                       string // "", daily, weekly, monthly, yearly or custom
	Interval                     string
	ByDay                        map[string]bool // weekly: MO…SU
	Custom                       string          // RRULE, EXDATE and RDATE lines
}

// occurrenceQuery is the ?occurrence= an Occurrence's links carry.
func occurrenceQuery(original int64) string {
	if original == 0 {
		return ""
	}
	return "?occurrence=" + id(original)
}

func id(n int64) string { return strconv.FormatInt(n, 10) }

func calendarTitle(p CalendarPage) string {
	switch p.View {
	case "day":
		return p.Date.Format("Monday 2 January 2006")
	case "week":
		return "Week of " + p.Days[0].Date.Format("2 January 2006")
	case "agenda":
		return "From " + p.Date.Format("2 January 2006")
	}
	return p.Date.Format("January 2006")
}

func eventURL(f EventForm, action string) templ.SafeURL {
	if f.ID == 0 {
		return "/calendar/event"
	}
	return templ.SafeURL("/calendar/event/" + id(f.ID) + action + occurrenceQuery(f.Occurrence))
}

func newEventURL(d time.Time) templ.SafeURL {
	return templ.SafeURL("/calendar/event/new?date=" + d.Format("2006-01-02"))
}

templ swatches(colors []string) {
	for _, c := range colors {
		<span aria-hidden="true" style={ "display:inline-block;width:.7em;height:.7em;border-radius:50%;background:" + c }></span>
	}
}

templ calendarDay(d CalendarDay, heading string) {
	<section data-date={ d.Date.Format("2006-01-02") } style={ templ.KV("opacity:.5", d.Faded) }>
		<h3>
			if d.Today {
				<strong>{ heading }</strong>
			} else {
				{ heading }
			}
		</h3>
		<ul>
			for _, e := range d.Events {
				<li>
					@swatches(e.Colors)
					<a href={ templ.SafeURL("/calendar/event/" + id(e.ID) + occurrenceQuery(e.Original)) }>{ e.Time } { e.Title }</a>
				</li>
			}
		</ul>
		<a href={ newEventURL(d.Date) } aria-label={ "New event on " + d.Date.Format("2 January") }>+</a>
	</section>
}

// Calendar is the main calendar page in one of its four views.
templ Calendar(p CalendarPage) {
	@layout("Calendar") {
		<main>
			<h1>{ calendarTitle(p) }</h1>
			<nav>
				<a href={ templ.SafeURL(p.Prev) }>Previous</a>
				<a href={ templ.SafeURL(p.Today) }>Today</a>
				<a href={ templ.SafeURL(p.Next) }>Next</a>
				|
				for _, v := range []string{"month", "week", "day", "agenda"} {
					<a
						href={ templ.SafeURL(p.ViewLinks[v]) }
						if v == p.View {
							aria-current="page"
						}
					>{ v }</a>
				}
				|
				<a href={ newEventURL(p.Date) }>New event</a>
			</nav>
			<form method="get" action="/calendar">
				<input type="hidden" name="view" value={ p.View }/>
				<input type="hidden" name="date" value={ p.Date.Format("2006-01-02") }/>
				<fieldset>
					<legend>Show Members (Household events always show)</legend>
					for _, m := range p.Members {
						<label>
							<input type="checkbox" name="users" value={ id(m.ID) } checked?={ p.Users[m.ID] }/>
							@avatar(m)
							{ m.Name }
						</label>
					}
					<button>Filter</button>
				</fieldset>
			</form>
			<div id="live">
				if p.View == "month" {
					<table>
						<thead>
							<tr>
								for _, d := range p.Days[:7] {
									<th>{ d.Date.Format("Mon") }</th>
								}
							</tr>
						</thead>
						<tbody>
							for w := 0; w < len(p.Days); w += 7 {
								<tr>
									for _, d := range p.Days[w : w+7] {
										<td style="vertical-align:top">
											@calendarDay(d, d.Date.Format("2"))
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				} else {
					for _, d := range p.Days {
						@calendarDay(d, d.Date.Format("Monday 2 January"))
					}
					if len(p.Days) == 0 {
						<p>Nothing on the calendar for these days.</p>
					}
				}
				<h2>Calendars</h2>
				<ul>
					for _, c := range p.Calendars {
						<li>
							@swatches([]string{c.Color})
							{ c.Name }
							<a href={ templ.SafeURL(p.ICS + "?calendars=" + strconv.FormatInt(c.ID, 10)) }>ICS</a>
						</li>
					}
				</ul>
				if len(p.Calendars) > 0 {
					<p>Subscribe to every calendar: <a href={ templ.SafeURL(p.ICS) }>{ p.ICS }</a></p>
				}
			</div>
			<form method="post" action="/calendar/calendars">
				<label>Name <input name="name" required maxlength="50"/></label>
				<label>Colour <input type="color" name="color" value="#a855f7"/></label>
				<button>Add calendar</button>
			</form>
		</main>
		@liveUpdates()
	}
}

// liveUpdates refetches this page and swaps in its #live region whenever
// anything changes, and on every (re)connect, catching up on missed changes.
// shortcut: native EventSource, not htmx's SSE extension; switch once htmx is vendored.
templ liveUpdates() {
	<script>
	(() => {
		const es = new EventSource("/events/stream");
		let inflight, retry;
		const refresh = async () => {
			clearTimeout(retry);
			inflight?.abort(); // a slower older fetch must not land after a newer one
			const ctl = inflight = new AbortController();
			try {
				const r = await fetch(location.href, { signal: ctl.signal });
				if (!r.ok) throw r.status;
				const next = new DOMParser().parseFromString(await r.text(), "text/html").getElementById("live");
				if (next) document.getElementById("live").replaceWith(next);
			} catch {
				// A failed fetch would leave the page stale until the next change; an aborted one was superseded.
				if (!ctl.signal.aborted) retry = setTimeout(refresh, 5000);
			}
		};
		es.onmessage = refresh;
		es.onopen = refresh;
		es.onerror = () => {
			// The browser gives up on an error response (e.g. a proxy's 502 mid-restart): reload, which retries.
			if (es.readyState === EventSource.CLOSED) setTimeout(() => location.reload(), 5000);
		};
	})();
	</script>
}

// EventPage is the event dialog: create, edit or delete a single event.
templ EventPage(f EventForm, cals []CalendarInfo, members []Member, errMsg string) {
	@layout("Event") {
		<main>
			<h1>
				if f.ID == 0 {
					New event
				} else {
					Edit event
				}
			</h1>
			<p><a href="/calendar">Back to the calendar</a></p>
			@formError(errMsg)
			if len(cals) == 0 {
				<p>Add a calendar on the calendar page first.</p>
			}
			<form method="post" action={ eventURL(f, "") }>
				<label>Title <input name="title" value={ f.Title } required maxlength="200"/></label>
				if f.Occurrence == 0 {
					<label>
						Calendar
						<select name="calendar_id" required>
							for _, c := range cals {
								<option value={ id(c.ID) } selected?={ c.ID == f.CalendarID }>{ c.Name }</option>
							}
						</select>
					</label>
				}
				<fieldset>
					<legend>Members (none: a Household event)</legend>
					for _, m := range members {
						<label>
							<input type="checkbox" name="members" value={ id(m.ID) } checked?={ f.Members[m.ID] }/>
							@avatar(m)
							{ m.Name }
						</label>
					}
				</fieldset>
				<label><input type="checkbox" name="all_day" checked?={ f.AllDay }/> All day</label>
				<fieldset>
					<legend>Timed</legend>
					<label>Starts <input type="datetime-local" name="start" value={ f.Start }/></label>
					<label>Ends <input type="datetime-local" name="end" value={ f.End }/></label>
					<label>Time zone <input name="tz" value={ f.TZ }/></label>
				</fieldset>
				<fieldset>
					<legend>All day</legend>
					<label>First day <input type="date" name="start_date" value={ f.StartDate }/></label>
					<label>Last day <input type="date" name="end_date" value={ f.EndDate }/></label>
				</fieldset>
				<fieldset>
					<legend>Repeats</legend>
					<select name="repeat">
						for _, o := range [][2]string{{"", "Doesn't repeat"}, {"daily", "Daily"}, {"weekly", "Weekly"}, {"monthly", "Monthly"}, {"yearly", "Yearly"}, {"custom", "Custom (advanced)"}} {
							<option value={ o[0] } selected?={ o[0] == f.Repeat }>{ o[1] }</option>
						}
					</select>
					<label>Every <input type="number" name="interval" min="1" max="999" value={ f.Interval } placeholder="1"/></label>
					<span>On (weekly)</span>
					for _, d := range []string{"MO", "TU", "WE", "TH", "FR", "SA", "SU"} {
						<label><input type="checkbox" name="byday" value={ d } checked?={ f.ByDay[d] }/> { d }</label>
					}
					<details open?={ f.Repeat == "custom" }>
						<summary>Advanced</summary>
						<label>RRULE, EXDATE and RDATE lines <textarea name="rrule" placeholder="RRULE:FREQ=MONTHLY;BYDAY=2TU">{ f.Custom }</textarea></label>
					</details>
				</fieldset>
				<label>Location <input name="location" value={ f.Location } maxlength="200"/></label>
				<label>Description <textarea name="description" maxlength="5000">{ f.Description }</textarea></label>
				if f.Occurrence != 0 {
					<fieldset>
						<legend>Change</legend>
						for _, s := range scopes {
							<label><input type="radio" name="scope" value={ s[0] } checked?={ s[0] == f.Scope }/> { s[1] }</label>
						}
						<p>All events changes the title, location, description and Members only. Time and repeat changes use This event or This and following, which starts a new Series here.</p>
					</fieldset>
					if f.Reset > 0 {
						<input type="hidden" name="reset" value={ strconv.Itoa(f.Reset) }/>
					}
					@scopePicker()
				}
				<button>Save</button>
			</form>
			if f.ID != 0 {
				<form method="post" action={ eventURL(f, "/delete") }>
					if f.Occurrence != 0 {
						for _, s := range scopes {
							<button name="scope" value={ s[0] }>Delete { strings.ToLower(s[1]) }</button>
						}
					} else {
						<button>Delete event</button>
					}
				</form>
			}
		</main>
	}
}

var scopes = [][2]string{{"this", "This event"}, {"following", "This and following events"}, {"all", "All events"}}

// scopePicker greys out the scopes an edit can't use: This event once the
// repeat changes, All events once the time or repeat does (spec §7.4).
templ scopePicker() {
	<script>
	(() => {
		const form = document.currentScript.closest("form");
		const changed = names => [...form.elements].some(el => names.includes(el.name) && (
			el.type === "checkbox" ? el.checked !== el.defaultChecked :
			el.tagName === "SELECT" ? [...el.options].some(o => o.selected !== o.defaultSelected) :
			el.value !== el.defaultValue));
		form.addEventListener("input", () => {
			const rule = changed(["repeat", "interval", "byday", "rrule"]);
			const time = rule || changed(["all_day", "start", "end", "tz", "start_date", "end_date"]);
			for (const [scope, off] of [["this", rule], ["all", time]]) {
				const el = form.querySelector(`[name=scope][value=${scope}]`);
				el.disabled = off;
				if (off && el.checked) form.querySelector("[name=scope][value=following]").checked = true;
			}
		});
	})();
	</script>
}
