package web

import (
	"cmp"
	"context"
	"strconv"
	"time"
)

// Device is this browser's own choices, kept in its cookies (Settings → This device).
type Device struct {
	Theme       string // "light", "dark" or "auto"
	DefaultView string // "" uses the Household's
	WallDisplay bool
	IdleSeconds int // a Wall display's screensaver_idle_seconds; 0 when unknown
}

// Household is the household settings the pages follow.
type Household struct {
	DefaultView     string // a page name: today, calendar, todos or lists
	Clock24         bool
	WeekStart       int    // 0 = Sunday
	IdleSeconds     int    // a Wall display's screensaver after this long with no input
	SecondsPerPhoto int    // each screensaver photo shows this long
	NightMode       string // "off", "black" or "dim_clock"
	NightStart      int    // hour 0-23
	NightEnd        int    // hour 0-23
}

type deviceKey struct{}

// WithDevice gives the pages rendered with ctx this device's choices.
func WithDevice(ctx context.Context, d Device) context.Context {
	return context.WithValue(ctx, deviceKey{}, d)
}

func device(ctx context.Context) Device {
	d, _ := ctx.Value(deviceKey{}).(Device)
	return d
}

func colorScheme(ctx context.Context) string {
	switch t := device(ctx).Theme; t {
	case "light", "dark":
		return t
	}
	return "light dark"
}

templ layout(title string) {
	@page(title, true) {
		{ children... }
	}
}

// page is a full page; Today has its large weather header instead of the pill.
templ page(title string, pill bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content={ colorScheme(ctx) }/>
			<title>{ title }</title>
		</head>
		<body>
			if pill {
				@weatherPill()
			}
			{ children... }
			if device(ctx).WallDisplay {
				@wallDisplay(cmp.Or(device(ctx).IdleSeconds, 300))
			}
		</body>
	</html>
}

// defaultViewButton makes view this device's Default view (no Lock).
templ defaultViewButton(view string) {
	<form method="post" action="/device/default-view">
		<input type="hidden" name="default_view" value={ view }/>
		<button>Set as default view on this device</button>
	</form>
}

templ householdSection(h Household) {
	<h2>Household</h2>
	<form method="post" action="/settings/household">
		<label>
			Default view (for devices that haven't set their own)
			<select name="default_view">
				@option("today", "Today", h.DefaultView)
				@option("calendar", "Calendar", h.DefaultView)
				@option("todos", "To-dos", h.DefaultView)
				@option("chores", "Chores", h.DefaultView)
				@option("lists", "Lists", h.DefaultView)
			</select>
		</label>
		<label><input type="checkbox" name="clock_24h" checked?={ h.Clock24 }/> 24-hour clock</label>
		<label>
			Week starts on
			<select name="week_start">
				for d := range 7 {
					@option(strconv.Itoa(d), time.Weekday(d).String(), strconv.Itoa(h.WeekStart))
				}
			</select>
		</label>
		<label>
			Wall display screensaver after
			<input type="number" name="screensaver_idle_seconds" value={ strconv.Itoa(h.IdleSeconds) } min="10" required/>
			seconds idle
		</label>
		<label>
			Seconds per photo
			<input type="number" name="seconds_per_photo" value={ strconv.Itoa(h.SecondsPerPhoto) } min="5" required/>
		</label>
		<label>
			Night mode (Wall displays)
			<select name="night_mode">
				@option("off", "Off", h.NightMode)
				@option("black", "Black (screen may turn off)", h.NightMode)
				@option("dim_clock", "Dim clock", h.NightMode)
			</select>
		</label>
		<label>
			from hour
			<input type="number" name="night_start" value={ strconv.Itoa(h.NightStart) } min="0" max="23" required/>
		</label>
		<label>
			to hour
			<input type="number" name="night_end" value={ strconv.Itoa(h.NightEnd) } min="0" max="23" required/>
		</label>
		<button>Save household</button>
	</form>
}

templ thisDevice() {
	<h2>This device</h2>
	<p>Kept in this browser only.</p>
	<p>
		Default view:
		if v := device(ctx).DefaultView; v != "" {
			<a href={ templ.SafeURL(v) }>{ v }</a>
		} else {
			Household default
		}
	</p>
	if device(ctx).DefaultView != "" {
		<form method="post" action="/device/default-view">
			<input type="hidden" name="default_view" value=""/>
			<button>Clear</button>
		</form>
	}
	<form method="post" action="/device/theme">
		<label>
			Theme
			<select name="theme">
				@option("light", "Light", device(ctx).Theme)
				@option("dark", "Dark", device(ctx).Theme)
				@option("auto", "Auto", device(ctx).Theme)
			</select>
		</label>
		<button>Save theme</button>
	</form>
	<form method="post" action="/device/wall-display">
		<label><input type="checkbox" name="wall_display" checked?={ device(ctx).WallDisplay }/> Wall display (goes to the screensaver when idle; Admin PIN needed)</label>
		<button>Save</button>
	</form>
	<p>
		Screen wake lock:
		<span id="wake-lock">
			if device(ctx).WallDisplay {
				checking…
			} else {
				off (not a Wall display)
			}
		</span>
	</p>
}
